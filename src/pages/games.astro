---
import BaseLayout from '../layouts/BaseLayout.astro';
import { games } from '../data/games';

const title = '🕹️ 独立游戏';
const description = '张坤开发的独立小游戏，全部可直接在线游玩';
---

<BaseLayout title={title} description={description}>
  <div class="container" style="padding-top: 2.5rem;">
    <div class="page-header">
      <h1 class="page-title">独立游戏</h1>
      <p class="page-subtitle">// Games</p>
    </div>

    <p class="games-intro">休闲小游戏<strong>直接托管在本站</strong>，点击即可游玩，无需跳转。视频默认只加载海报，点击播放后才下载。开源项目请移步 <a href="/projects/">Projects</a>。</p>

    {games.map((game) => (
      <div class="game-showcase" id={`game-${game.id}`}>
        <div class="gs-media-col">
          <div class="gs-main" data-media={game.id}>
            <div class="gs-display gs-display--active" data-type="video">
              <button
                class="gs-video-loader"
                type="button"
                data-video={game.video}
                data-poster={game.poster}
                aria-label={`播放《${game.name}》演示视频`}
                onclick={`window.__loadGSVideo('${game.id}', this)`}
              >
                <img src={game.poster} alt={`${game.name} 游戏海报`} loading="lazy" />
                <span class="gs-play-icon" aria-hidden="true">▶</span>
                <span class="gs-play-label">播放演示</span>
              </button>
            </div>
            <div class="gs-display" data-type="shot">
              <img src={game.poster} alt={`${game.name} 游戏截图`} loading="lazy" />
            </div>
            <button class="gs-corner-toggle" onclick={`event.stopPropagation();window.__toggleGSMode('${game.id}', this)`} title="切换视频/截图">
              <span class="gct-icon">🖼️</span>
              <span class="gct-label">截图</span>
            </button>
          </div>
        </div>
        <div class="gs-info-col">
          <h2>{game.icon} {game.name}</h2>
          <p class="game-subtitle">{game.description}</p>
          <dl class="game-meta">
            <div><dt>平台</dt><dd>{game.platform}</dd></div>
            <div><dt>状态</dt><dd>{game.status}</dd></div>
            <div><dt>操作</dt><dd>{game.controls}</dd></div>
            <div><dt>更新</dt><dd><time datetime={game.updatedAt}>{game.updatedAt}</time></dd></div>
            <div><dt>版本</dt><dd>{game.version}</dd></div>
          </dl>
          <div class="game-actions">
            <a class={`btn-play btn-play--${game.accent}`} href={game.playUrl} target="_blank" rel="noopener">▶ 在线试玩</a>
            <a class="btn-play btn-play--ghost" href={`/games/details/${game.id}/`}>详情与评论</a>
            <span class="game-tags">{game.tags.map((tag) => <span class="tag">{tag}</span>)}</span>
          </div>
        </div>
      </div>
    ))}

    <p class="games-more">📺 More on <a href="https://space.bilibili.com/31032895" target="_blank" rel="noopener">bilibili</a></p>
  </div>

  <script src="/js/game-switcher.js" is:inline></script>
</BaseLayout>
