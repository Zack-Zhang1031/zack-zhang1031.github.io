---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '🎮 作品 & 项目';
const description = '张坤的独立游戏与开源项目展示';

const githubProjects = [
  {
    name: 'MindFace-Lite',
    badge: 'AI',
    url: 'https://github.com/Zack-Zhang1031/MindFace-Lite',
    desc: '轻量实时语音驱动数字人口型系统，从 PyTorch 训练到 ONNX 跨平台推理，最终部署到 RKNN 边缘端。',
    tech: ['PyTorch', 'ONNX', 'RKNN', 'Python'],
    features: [
      '实时语音 → 口型参数映射',
      'ONNX 跨平台推理导出',
      'RKNN 边缘端加速部署',
    ],
  },
  {
    name: 'word_tool',
    badge: '⭐',
    star: true,
    url: 'https://github.com/Zack-Zhang1031/word_tool',
    desc: '从 PDF / TXT / Excel 中提取英文单词，批量翻译并导出 Excel，支持 OCR 识别图片中的文字。',
    tech: ['Python', 'OCR', 'OpenPyXL', 'Translate API'],
    features: [
      '多格式文件输入 (PDF/TXT/Excel)',
      'OCR 识别图片内文字',
      '批量翻译 → 导出 Excel',
    ],
  },
  {
    name: 'crisis-social-media-classification',
    badge: 'ML',
    url: 'https://github.com/Zack-Zhang1031/crisis-social-media-classification',
    desc: '危机事件社交媒体文本分类的机器学习实验与性能分析，涵盖特征工程与多模型对比。',
    tech: ['Python', 'Scikit-learn', 'NLP', 'TF-IDF'],
    features: [
      'TF-IDF + 多模型对比实验',
      '特征工程与消融分析',
      '分类性能可视化报告',
    ],
  },
  {
    name: 'yolo11-small-object-enhancement',
    badge: 'CV',
    url: 'https://github.com/Zack-Zhang1031/yolo11-small-object-enhancement',
    desc: 'YOLOv11 小目标检测增强方案：SAHI 切片推理 + 模型微调，显著提升密集小目标场景检测率。VisDrone 数据集上 SAHI+微调使小目标 mAP@50-95 从 0.099 提升至 0.203（翻倍），整体 mAP 从 0.190 提升至 0.297（+56%）；SAHI 使 mAP@0.5 提升 12.7pp，小目标 AP 提升 +24.3%。',
    tech: ['YOLOv11', 'SAHI', 'PyTorch', 'Python'],
    features: [
      'SAHI 切片推理流程（小目标 mAP 翻倍：0.099→0.203）',
      '小目标数据集微调（整体 mAP +56%：0.190→0.297）',
      '检测率提升对比实验（mAP@0.5 +12.7pp，小目标 AP +24.3%）',
    ],
  },
  {
    name: 'yolo11-tensorrt-realtime',
    badge: 'Deploy',
    url: 'https://github.com/Zack-Zhang1031/yolo11-tensorrt-realtime',
    desc: 'YOLOv11 + TensorRT 部署加速：FP16 / INT8 量化推理，实现 GPU 端实时目标检测。',
    tech: ['YOLOv11', 'TensorRT', 'FP16', 'INT8'],
    features: [
      'FP16 / INT8 量化推理',
      'TensorRT Engine 构建',
      '实时推理性能基准测试',
    ],
  },
];

const giteeProjects = [
  {
    name: 'MindTrip',
    badge: 'AI',
    url: 'https://gitee.com/rainyjensen/mind-trip',
    desc: '基于 RAG + Agent 的智能旅行规划系统，结合大语言模型与向量检索，生成个性化行程方案。',
    tech: ['Qwen2-72B', 'Milvus', 'LangChain', 'FastAPI', 'UniApp'],
    features: [
      'RAG 知识库检索增强',
      'Agent 多步行程规划',
      'FastAPI 后端 + UniApp 前端',
    ],
  },
  {
    name: 'AtlasSplit',
    badge: 'Agent',
    url: 'https://gitee.com/rainyjensen/AtlasSplit',
    desc: '表格分摊与结算智能体：自然语言指令 → 受控代码生成 → 本地安全执行 → 可审计结果。',
    tech: ['LLM', 'Python', 'Code Gen', 'Sandbox'],
    features: [
      '自然语言 → 分摊规则',
      '受控代码本地执行',
      '全程可审计的结果输出',
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="container" style="padding-top: 2.5rem;">
    <div class="page-header">
      <h1 class="page-title">作品 & 项目</h1>
      <p class="page-subtitle">// games · projects</p>
    </div>

    <nav class="anchor-nav">
      <a href="#games">🕹️ 独立游戏</a>
      <a href="#github">🐙 GitHub</a>
      <a href="#gitee">🐱 Gitee</a>
    </nav>

    <hr class="divider" />

    <h2 id="games" class="section-label" style="font-size: 1.3rem; color: var(--text-primary); margin-bottom: 0.5rem;">🕹️ 独立游戏</h2>
    <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 2rem;">休闲小游戏<strong>直接托管在本站</strong>，点击即可游玩，无需跳转。</p>

    <!-- 数钱 -->
    <div class="game-showcase" id="game-shuqian">
      <div class="gs-media-col">
        <div class="gs-main" data-media="shuqian">
          <div class="gs-display gs-display--active" data-type="video">
            <video controls preload="metadata" poster="/images/shuqian-1.png">
              <source src="/videos/shuqian-demo.mp4" type="video/mp4" />
              您的浏览器不支持视频播放。
            </video>
          </div>
          <div class="gs-display" data-type="shot">
            <img src="/images/shuqian-1.png" alt="数钱 游戏截图" loading="lazy" />
          </div>
          <button class="gs-corner-toggle" onclick="event.stopPropagation();window.__toggleGSMode('shuqian', this)" title="切换视频/截图">
            <span class="gct-icon">🖼️</span>
            <span class="gct-label">shot</span>
          </button>
        </div>
      </div>
      <div class="gs-info-col">
        <h3>💰 数钱</h3>
        <p class="game-subtitle">轻松休闲的点钞小游戏，考验你的手速与眼力。在限定时间内尽可能准确地清点钞票，挑战更高分数。</p>
        <div class="game-controls-bar">
          <button class="gs-ctrl-btn" onclick="window.__toggleVideoMute('shuqian', this)">🔇 mute</button>
          <span class="gs-ctrl-hint">▶ click video to play</span>
        </div>
        <div class="game-actions">
          <a class="btn-play btn-play--amber" href="/games/shuqian/" target="_blank" rel="noopener">▶ 在线试玩</a>
          <a class="btn-play btn-play--ghost" href="https://www.crazygames.com/preview/d1b4d9b3-f1e7-419c-8336-c65c37fa3419?gameBuildId=10c47402-f440-40f9-a940-448fa1466cd3&qaTool=true&disableSubmitQA=true&role=developer" target="_blank" rel="noopener">外部试玩</a>
          <span class="game-tags"><span class="tag">休闲</span><span class="tag">点击</span></span>
        </div>
      </div>
    </div>

    <hr class="divider" />

    <!-- 捡钱 -->
    <div class="game-showcase" id="game-jianqian">
      <div class="gs-media-col">
        <div class="gs-main" data-media="jianqian">
          <div class="gs-display gs-display--active" data-type="video">
            <video controls preload="metadata" poster="/images/jianqian-1.png">
              <source src="/videos/jianqian-demo.mp4" type="video/mp4" />
              您的浏览器不支持视频播放。
            </video>
          </div>
          <div class="gs-display" data-type="shot">
            <img src="/images/jianqian-1.png" alt="捡钱 游戏截图" loading="lazy" />
          </div>
          <button class="gs-corner-toggle" onclick="event.stopPropagation();window.__toggleGSMode('jianqian', this)" title="切换视频/截图">
            <span class="gct-icon">🖼️</span>
            <span class="gct-label">shot</span>
          </button>
        </div>
      </div>
      <div class="gs-info-col">
        <h3>💵 捡钱</h3>
        <p class="game-subtitle">欢乐的街机小游戏，操控角色接住天上掉落的金币与红包，躲开陷阱，比拼连击与高分。</p>
        <div class="game-controls-bar">
          <button class="gs-ctrl-btn" onclick="window.__toggleVideoMute('jianqian', this)">🔇 mute</button>
          <span class="gs-ctrl-hint">▶ click video to play</span>
        </div>
        <div class="game-actions">
          <a class="btn-play btn-play--gold" href="/games/jianqian/" target="_blank" rel="noopener">▶ 在线试玩</a>
          <a class="btn-play btn-play--ghost" href="https://www.crazygames.com/preview/e072a216-66f6-45da-92e1-5462cc4a1309?gameBuildId=30f942ad-72fc-4858-b812-95dfa984c8f0&qaTool=true&disableSubmitQA=true&role=developer" target="_blank" rel="noopener">外部试玩</a>
          <span class="game-tags"><span class="tag">街机</span><span class="tag">休闲</span></span>
        </div>
      </div>
    </div>

    <hr class="divider" />

    <p style="text-align:center; color:var(--text-muted); font-family: var(--font-mono); font-size: 0.8rem; margin-bottom: 2.5rem;">📺 more on <a href="https://space.bilibili.com/31032895" target="_blank" rel="noopener">bilibili</a></p>

    <hr class="divider" />

    <!-- GitHub -->
    <h2 id="github" class="section-label" style="font-size: 1.3rem; color: var(--text-primary); margin-bottom: 1rem;">🐙 GitHub</h2>
    <div class="project-grid" style="margin-bottom: 2.5rem;">
      {githubProjects.map((p) => (
        <a class="project-card" href={p.url} target="_blank" rel="noopener">
          <div class="project-card-header">
            <span class="project-card-name">{p.name}</span>
            <span class={`project-card-badge${p.star ? ' project-card-badge--star' : ''}`}>{p.badge}</span>
          </div>
          <div class="project-card-body">
            <p class="project-card-desc">{p.desc}</p>
            <div class="project-tech">
              {p.tech.map((t) => <span class="tag">{t}</span>)}
            </div>
            <ul class="project-features">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <div class="project-card-footer">
              <span class="project-card-arrow">view repo →</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <hr class="divider" />

    <!-- Gitee -->
    <h2 id="gitee" class="section-label" style="font-size: 1.3rem; color: var(--text-primary); margin-bottom: 1rem;">🐱 Gitee</h2>
    <div class="project-grid" style="margin-bottom: 2.5rem;">
      {giteeProjects.map((p) => (
        <a class="project-card" href={p.url} target="_blank" rel="noopener">
          <div class="project-card-header">
            <span class="project-card-name">{p.name}</span>
            <span class="project-card-badge">{p.badge}</span>
          </div>
          <div class="project-card-body">
            <p class="project-card-desc">{p.desc}</p>
            <div class="project-tech">
              {p.tech.map((t) => <span class="tag">{t}</span>)}
            </div>
            <ul class="project-features">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <div class="project-card-footer">
              <span class="project-card-arrow">view repo →</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <hr class="divider" />
    <p style="text-align:center; color:var(--text-secondary); font-size: 0.82rem; margin-bottom: 2.5rem;">
      想了解更多或合作？<a href="/">← 返回首页</a> 查看联系方式
    </p>
  </div>

  <script src="/js/game-switcher.js" is:inline></script>
</BaseLayout>
