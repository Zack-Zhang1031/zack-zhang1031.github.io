---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const title = 'Zack-Zhang1031 | 个人主页';
const description = '独立游戏开发者 / AI 与算法爱好者。在这里可以找到我发布的独立游戏、开源项目与技术随笔。';
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <a href="/about/" class="hero-avatar-link">
        <img src="/images/48.png" alt="Zack-Zhang1031" class="hero-avatar" />
      </a>
      <h1 class="hero-title">Zack-Zhang1031</h1>
      <p class="hero-motto">热爱 AI、游戏与极客文化 🎮</p>
      <div class="hero-links">
        <a href="https://github.com/Zack-Zhang1031" target="_blank" rel="noopener" class="hero-btn hero-btn--ghost">GitHub</a>
        <a href="https://gitee.com/rainyjensen" target="_blank" rel="noopener" class="hero-btn hero-btn--ghost">Gitee</a>
        <a href="https://space.bilibili.com/31032895" target="_blank" rel="noopener" class="hero-btn hero-btn--ghost">Bilibili</a>
        <a href="mailto:zhangkun1031@hotmail.com" class="hero-btn hero-btn--ghost">Email</a>
      </div>
    </div>
  </section>

  <!-- Works Showcase -->
  <section class="home-section">
    <div class="section-header">
      <h2 class="section-title">🎮 我的作品</h2>
      <a href="/games/" class="section-more">全部作品 →</a>
    </div>
    <div class="works-grid">
      <div class="work-card work-card--amber">
        <div class="work-media" data-media="shuqian">
          <div class="wm-display wm-display--active" data-type="video">
            <video class="wm-real-video" controls preload="metadata" poster="/images/shuqian-1.png">
              <source src="/videos/shuqian-demo.mp4" type="video/mp4" />
            </video>
          </div>
          <div class="wm-display" data-type="shot">
            <img src="/images/shuqian-1.png" alt="数钱 游戏截图" class="wm-shot-img" loading="lazy" />
          </div>
          <button class="wm-toggle" onclick="event.stopPropagation();window.__toggleHCMode('shuqian', this)" title="切换视频/截图">
            <span class="wm-toggle-icon">🖼️</span>
            <span class="wm-toggle-label">截图</span>
          </button>
        </div>
        <div class="work-info">
          <h3>💰 数钱</h3>
          <p>休闲点钞小游戏 · 考验手速与眼力</p>
          <div class="work-actions-inline">
            <a class="play-btn play-btn--amber play-btn--sm" href="/games/shuqian/" target="_blank" rel="noopener">▶ 在线试玩</a>
            <button class="mute-btn-sm" onclick="window.__toggleVideoMute('shuqian', this)">🔇 静音</button>
            <div class="work-tags"><span class="work-tag">休闲</span></div>
          </div>
        </div>
      </div>

      <div class="work-card work-card--green">
        <div class="work-media" data-media="jianqian">
          <div class="wm-display wm-display--active" data-type="video">
            <video class="wm-real-video" controls preload="metadata" poster="/images/jianqian-1.png">
              <source src="/videos/jianqian-demo.mp4" type="video/mp4" />
            </video>
          </div>
          <div class="wm-display" data-type="shot">
            <img src="/images/jianqian-1.png" alt="捡钱 游戏截图" class="wm-shot-img" loading="lazy" />
          </div>
          <button class="wm-toggle" onclick="event.stopPropagation();window.__toggleHCMode('jianqian', this)" title="切换视频/截图">
            <span class="wm-toggle-icon">🖼️</span>
            <span class="wm-toggle-label">截图</span>
          </button>
        </div>
        <div class="work-info">
          <h3>💵 捡钱</h3>
          <p>欢乐街机小游戏 · 接金币躲陷阱</p>
          <div class="work-actions-inline">
            <a class="play-btn play-btn--green play-btn--sm" href="/games/jianqian/" target="_blank" rel="noopener">▶ 在线试玩</a>
            <button class="mute-btn-sm" onclick="window.__toggleVideoMute('jianqian', this)">🔇 静音</button>
            <div class="work-tags"><span class="work-tag">街机</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Open Source Projects -->
  <section class="home-section">
    <div class="section-header">
      <h2 class="section-title">💻 开源项目</h2>
      <a href="/games/#github" class="section-more">全部项目 →</a>
    </div>
    <div class="project-grid">
      <a class="project-card" href="https://github.com/Zack-Zhang1031/MindFace-Lite" target="_blank" rel="noopener">
        <div class="pc-head"><strong>MindFace-Lite</strong><span class="pc-platform" title="GitHub">🐙</span></div>
        <p class="pc-desc">轻量实时语音驱动数字人口型系统：PyTorch 训练 + ONNX 部署 + RKNN 边缘部署。</p>
        <div class="pc-tech"><span class="pc-tech-tag">Python</span><span class="pc-tech-tag">PyTorch</span><span class="pc-tech-tag">ONNX</span></div>
      </a>
      <a class="project-card" href="https://github.com/Zack-Zhang1031/word_tool" target="_blank" rel="noopener">
        <div class="pc-head"><strong>word_tool</strong><span class="pc-platform" title="GitHub">🐙</span></div>
        <p class="pc-desc">PDF/TXT/Excel 英文单词提取工具：过滤已学单词 + 批量翻译，导出 Excel，支持 OCR。</p>
        <div class="pc-tech"><span class="pc-tech-tag">Python</span><span class="pc-tech-tag">OCR</span><span class="pc-tech-tag">PDF</span></div>
      </a>
      <a class="project-card" href="https://github.com/Zack-Zhang1031/crisis-social-media-classification" target="_blank" rel="noopener">
        <div class="pc-head"><strong>crisis-social-media-classification</strong><span class="pc-platform" title="GitHub">🐙</span></div>
        <p class="pc-desc">危机事件社交媒体文本分类的机器学习实验与分析。</p>
        <div class="pc-tech"><span class="pc-tech-tag">Python</span><span class="pc-tech-tag">scikit-learn</span><span class="pc-tech-tag">NLP</span></div>
      </a>
      <a class="project-card" href="https://gitee.com/rainyjensen/AtlasSplit" target="_blank" rel="noopener">
        <div class="pc-head"><strong>AtlasSplit</strong><span class="pc-platform" title="Gitee">🐱</span></div>
        <p class="pc-desc">输入 Excel/CSV + 需求描述，自动完成统计、分摊、校验并写回结果。</p>
        <div class="pc-tech"><span class="pc-tech-tag">Python</span><span class="pc-tech-tag">pandas</span><span class="pc-tech-tag">Excel</span></div>
      </a>
      <a class="project-card" href="https://gitee.com/rainyjensen/mind-trip" target="_blank" rel="noopener">
        <div class="pc-head"><strong>MindTrip</strong><span class="pc-platform" title="Gitee">🐱</span></div>
        <p class="pc-desc">基于 RAG + Agent 的智能旅行规划系统：Qwen2-72B + Milvus + LangChain + FastAPI + UniApp。</p>
        <div class="pc-tech"><span class="pc-tech-tag">Python</span><span class="pc-tech-tag">RAG</span><span class="pc-tech-tag">LangChain</span></div>
      </a>
      <a class="project-card" href="https://github.com/Zack-Zhang1031/yolo11-small-object-enhancement" target="_blank" rel="noopener">
        <div class="pc-head"><strong>yolo11-small-object-enhancement</strong><span class="pc-platform" title="GitHub">🐙</span></div>
        <p class="pc-desc">YOLOv11 小目标检测增强：SAHI 切片推理 + 模型微调，提升密集小目标场景检出率。</p>
        <div class="pc-tech"><span class="pc-tech-tag">Python</span><span class="pc-tech-tag">YOLOv11</span><span class="pc-tech-tag">SAHI</span></div>
      </a>
      <a class="project-card" href="https://github.com/Zack-Zhang1031/yolo11-tensorrt-realtime" target="_blank" rel="noopener">
        <div class="pc-head"><strong>yolo11-tensorrt-realtime</strong><span class="pc-platform" title="GitHub">🐙</span></div>
        <p class="pc-desc">YOLOv11 + TensorRT 部署加速：FP16/INT8 量化推理，实现边缘端实时目标检测。</p>
        <div class="pc-tech"><span class="pc-tech-tag">Python</span><span class="pc-tech-tag">TensorRT</span><span class="pc-tech-tag">YOLOv11</span></div>
      </a>
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="home-section">
    <div class="section-header">
      <h2 class="section-title">📝 最新日志</h2>
      <a href="/posts/" class="section-more">全部日志 →</a>
    </div>
    <div class="home-posts">
      {posts.map((post) => (
        <div class="home-post-item">
          <a href={`/posts/${post.slug}/`} class="home-post-link">
            <h3 class="home-post-title">{post.data.title}</h3>
            <div class="home-post-meta">
              <time>{post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-')}</time>
              {post.data.tags.length > 0 && (
                <span class="home-post-tags">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class="home-post-tag">#{tag}</span>
                  ))}
                </span>
              )}
            </div>
            <p class="home-post-summary">{post.data.description || ''}</p>
          </a>
        </div>
      ))}
    </div>
    <div class="home-posts-more">
      <a href="/posts/" class="hero-btn hero-btn--ghost">查看全部日志 →</a>
    </div>
  </section>

  <!-- Game switcher JS -->
  <script src="/js/game-switcher.js" is:inline></script>
</BaseLayout>
