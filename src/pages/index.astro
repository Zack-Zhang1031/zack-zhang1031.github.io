---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '张坤个人主页';
const description = '独立游戏开发者 / AI 与算法爱好者。在这里可以找到我发布的独立游戏、开源项目与技术随笔。';
---

<BaseLayout title={title} description={description}>
  <section class="hero" style="min-height: 75vh; display: flex; align-items: center; justify-content: center;">
    <div style="text-align: center;">
      <div class="seal">张</div>
      <p class="hero-tag">Indie game dev · AI · geek</p>
      <h1 class="hero-title">张坤</h1>
      <p class="hero-desc">热爱 AI、游戏与极客文化。把想法做成能玩、能用的东西。</p>
      <div class="hero-links">
        <a href="/projects/" class="hero-link-primary">See what I built →</a>
        <a href="/posts/" class="hero-link">Read blog →</a>
        <a href="/about/" class="hero-link">About me →</a>
      </div>
      <div class="hero-links" style="margin-top: 1rem;">
        <a href="https://github.com/Zack-Zhang1031" target="_blank" rel="noopener" class="hero-link">GitHub ↗</a>
        <a href="https://gitee.com/rainyjensen" target="_blank" rel="noopener" class="hero-link">Gitee ↗</a>
        <button class="hero-link" data-qr-trigger style="cursor: pointer;">公众号 📱</button>
      </div>
    </div>
  </section>

  <section style="display: flex; justify-content: center; padding: 0 1.5rem 4rem;">
    <a href="/posts/ai-learning-roadmap/" class="roadmap-card" style="display: block; max-width: 720px; width: 100%; text-decoration: none; border: 1px solid var(--border, #e5e7eb); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.06); transition: transform 0.2s ease, box-shadow 0.2s ease;">
      <img src="/images/ai-learning-roadmap.png" alt="AI 学习路线图：模块依赖总览" style="width: 100%; display: block;" loading="lazy" />
      <div style="padding: 1.25rem 1.5rem 1.5rem;">
        <p style="margin: 0 0 0.35rem; font-size: 0.85rem; letter-spacing: 0.08em; color: #8b5cf6; font-weight: 600;">置顶导航</p>
        <h2 style="margin: 0 0 0.5rem; font-size: 1.35rem; color: var(--text, #111827);">AI 学习路线图：77 篇实战文章的完整路径 →</h2>
        <p style="margin: 0; color: var(--text-secondary, #6b7280); font-size: 0.95rem; line-height: 1.6;">从 Linux 到 LLM：四阶段主线 + 十大模块 + 难度星级 + 24 周节奏建议，告诉你每篇文章该在什么时候读。</p>
      </div>
    </a>
  </section>
  <style>
    .roadmap-card:hover { transform: translateY(-3px); box-shadow: 0 10px 32px rgba(0,0,0,0.10); }
  </style>
</BaseLayout>
