---
import JingLayout from '../../layouts/JingLayout.astro';
import YijingCaster from '../../components/jing/YijingCaster.astro';
import StudyTabs from '../../components/jing/StudyTabs.astro';
---

<JingLayout title="周易" description="静心堂 · 本地起卦研习">
  <StudyTabs current="yijing" />
  <section class="jing-study-page jing-yijing-page">
    <header class="jing-study-page-heading">
      <p class="jing-eyebrow">六爻成卦 · 观象研习</p>
      <h1>周易</h1>
      <p>铜钱、蓍草、数字、时间与手动五种方式均保留；六爻自下而上生成，仅演算卦形与名相。</p>
    </header>
    <YijingCaster />
  </section>
</JingLayout>
