---
import JingLayout from '../../layouts/JingLayout.astro';
import ReverencePanel from '../../components/jing/ReverencePanel.astro';
import { TAOIST_FIGURES } from '../../data/jing/figures';
---

<JingLayout title="敬道" description="静心堂 · 道室">
  <h1>敬道</h1>
  <p class="jing-page-desc">
    道室供奉三清：玉清元始天尊、上清灵宝天尊、太清道德天尊。图像仅作瞻仰与介绍之用，不是可点击的机关。
  </p>

  <div class="jing-figures">
    {TAOIST_FIGURES.map((figure) => (
      <figure class="jing-figure">
        <img src={figure.image.src} alt={figure.image.alt} loading="lazy" decoding="async" />
        <figcaption>
          <h2>{figure.name}<span class="jing-figure-title">{figure.title}</span></h2>
          <p>{figure.intro}</p>
          <p class="jing-figure-credit">
            {figure.image.attribution} · {figure.image.license} ·
            <a href={figure.image.sourceUrl} target="_blank" rel="noopener">来源</a>
          </p>
        </figcaption>
      </figure>
    ))}
  </div>

  <ReverencePanel tradition="taoist" />
</JingLayout>
