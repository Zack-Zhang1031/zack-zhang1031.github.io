---
import JingLayout from '../../layouts/JingLayout.astro';
import HallIntro from '../../components/jing/HallIntro.astro';
---

<JingLayout title="静心堂" isHall>
  <section class="jing-hall-stage" aria-labelledby="hall-title">
    <div class="jing-hall-heading">
      <p class="jing-eyebrow">一方净境 · 一念归心</p>
      <h1 id="hall-title" class="jing-hall-title">静心堂</h1>
      <p class="jing-hall-sub">心静则明 · 福自归来</p>
    </div>

    <nav class="jing-hall-portals" aria-label="静心堂主要入口">
      <a href="/jing/meditation/" class="jing-portal-card" data-portal="meditation">
        <span class="jing-portal-figure" aria-hidden="true">静</span>
        <span class="jing-portal-copy"><strong>静心</strong><small>静坐 · 呼吸<br />回归本心</small></span>
      </a>
      <a href="/jing/fo/" class="jing-portal-card" data-portal="reverence">
        <span class="jing-portal-figure" aria-hidden="true">礼</span>
        <span class="jing-portal-copy"><strong>礼敬</strong><small>礼佛 · 敬道<br />心诚则灵</small></span>
      </a>
      <a href="/jing/muyu/" class="jing-portal-card" data-portal="woodfish">
        <span class="jing-portal-figure" aria-hidden="true">木</span>
        <span class="jing-portal-copy"><strong>木鱼</strong><small>敲击木鱼<br />增长功德</small></span>
      </a>
      <a href="/jing/chouqian/" class="jing-portal-card" data-portal="lots">
        <span class="jing-portal-figure" aria-hidden="true">签</span>
        <span class="jing-portal-copy"><strong>抽签</strong><small>诚心一摇<br />指引前行</small></span>
      </a>
    </nav>

    <div class="jing-hall-status" role="status" aria-label="本机静修记录">
      <span>今日功德 <strong id="hall-today-merit">0</strong></span>
      <i aria-hidden="true"></i>
      <span>累计功德 <strong id="hall-total-merit">0</strong></span>
      <i aria-hidden="true"></i>
      <span>静心时长 <strong id="hall-meditation-time">00:00:00</strong></span>
    </div>

    <details class="jing-hall-about">
      <summary>关于静心堂与本地隐私</summary>
      <HallIntro />
    </details>
  </section>
</JingLayout>

<script>
  const todayKey = new Date().toISOString().slice(0, 10);
  const formatDuration = (seconds: number) => {
    const safe = Math.max(0, Math.floor(seconds || 0));
    const h = String(Math.floor(safe / 3600)).padStart(2, '0');
    const m = String(Math.floor((safe % 3600) / 60)).padStart(2, '0');
    const s = String(safe % 60).padStart(2, '0');
    return `${h}:${m}:${s}`;
  };

  try {
    const raw = localStorage.getItem('jing.practice.v1');
    const practice = raw ? JSON.parse(raw) : {};
    const today = practice.date === todayKey ? Number(practice.todayMerit || 0) : 0;
    document.getElementById('hall-today-merit')!.textContent = String(today);
    document.getElementById('hall-total-merit')!.textContent = String(Number(practice.totalMerit || 0));
    document.getElementById('hall-meditation-time')!.textContent = formatDuration(Number(practice.meditationSeconds || 0));
  } catch {}
</script>
