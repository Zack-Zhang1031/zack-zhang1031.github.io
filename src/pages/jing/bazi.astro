---
import JingLayout from '../../layouts/JingLayout.astro';
import BaziForm from '../../components/jing/BaziForm.astro';
import StudyTabs from '../../components/jing/StudyTabs.astro';
---

<JingLayout title="八字" description="静心堂 · 本地八字排盘研习">
  <StudyTabs current="bazi" />
  <section class="jing-study-page jing-bazi-page">
    <header class="jing-study-page-heading">
      <p class="jing-eyebrow">四柱排盘 · 本地推演</p>
      <h1>八字</h1>
      <p>年柱以立春换年，月柱以十二节换月；可选真太阳时与晚子时规则。输入不上传、不留存。</p>
    </header>
    <BaziForm />
  </section>
</JingLayout>
