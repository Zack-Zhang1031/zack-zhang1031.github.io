---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allCats = [...new Set(posts.flatMap(p => p.data.categories))].sort();
const title = '日志';
const description = 'Zack-Zhang1031 的技术随笔与开发日志';
---

<BaseLayout title={title} description={description}>
  <div class="posts-page mt-8 px-4">
    <div class="posts-header">
      <h1 class="posts-page-title">📝 {title}</h1>
      <p class="posts-page-count">共 {posts.length} 篇日志</p>
    </div>

    {allCats.length > 0 && (
      <div class="posts-filter-bar">
        <button class="filter-chip filter-chip--active" data-cat="all">全部</button>
        {allCats.map((cat) => (
          <button class="filter-chip" data-cat={cat}>{cat}</button>
        ))}
      </div>
    )}

    <div class="posts-grid">
      {posts.map((post) => (
        <article class="post-card" data-cats={post.data.categories.join('||')}>
          <a href={`/posts/${post.slug}/`} class="post-card-link">
            <div class="post-card-top">
              <span class="post-card-date">{post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-')}</span>
              {post.data.categories.length > 0 && (
                <span class="post-card-cat">{post.data.categories[0]}</span>
              )}
            </div>
            <h2 class="post-card-title">{post.data.title}</h2>
            <p class="post-card-summary">{post.data.description || ''}</p>
            <div class="post-card-bottom">
              <div class="post-card-tags">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="post-card-tag">#{tag}</span>
                ))}
              </div>
              <span class="post-card-read">📖 约 {Math.ceil(post.body.split('\n').join('').length / 500)} 分钟</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      var chips = document.querySelectorAll('.filter-chip');
      var cards = document.querySelectorAll('.post-card');
      chips.forEach(function(chip) {
        chip.addEventListener('click', function() {
          var cat = this.dataset.cat;
          chips.forEach(function(c) { c.classList.remove('filter-chip--active'); });
          this.classList.add('filter-chip--active');
          cards.forEach(function(card) {
            var cats = (card.dataset.cats || '').split('||');
            if (cat === 'all' || cats.indexOf(cat) !== -1) {
              card.style.display = '';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</BaseLayout>
