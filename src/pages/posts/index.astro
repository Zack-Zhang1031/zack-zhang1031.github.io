---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allCats = [...new Set(posts.flatMap(p => p.data.categories))].sort();
const title = '日志';
const description = 'Zack-Zhang1031 的技术随笔与开发日志';
---

<BaseLayout title={title} description={description}>
  <div class="container" style="padding-top: 2.5rem;">
    <div class="page-header">
      <h1 class="page-title">日志</h1>
      <p class="page-subtitle">// {posts.length} Posts</p>
    </div>

    {allCats.length > 0 && (
      <div class="filter-bar">
        <button class="filter-chip filter-chip--active" data-cat="all">All</button>
        {allCats.map((cat) => <button class="filter-chip" data-cat={cat}>{cat}</button>)}
      </div>
    )}

    <div class="post-list">
      {posts.map((post) => (
        <article class="post-card" data-cats={post.data.categories.join('||')}>
          <a href={`/posts/${post.slug}/`} class="post-card-link">
            <div class="post-card-top">
              <span class="post-card-date">{post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-')}</span>
              {post.data.categories.length > 0 && <span class="post-card-cat">{post.data.categories[0]}</span>}
            </div>
            <h3 class="post-card-title">{post.data.title}</h3>
            <p class="post-card-summary">{post.data.description || ''}</p>
            <div class="post-card-bottom">
              <div class="post-card-tags">
                {post.data.tags.slice(0, 3).map((tag) => <span class="post-card-tag">#{tag}</span>)}
              </div>
              <span class="post-card-read">{Math.ceil(post.body.split('').length / 500)}min</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      var chips = document.querySelectorAll('.filter-chip');
      var cards = document.querySelectorAll('.post-card');
      chips.forEach(function(chip) {
        chip.addEventListener('click', function() {
          var cat = this.dataset.cat;
          chips.forEach(function(c) { c.classList.remove('filter-chip--active'); });
          this.classList.add('filter-chip--active');
          cards.forEach(function(card) {
            var cats = (card.dataset.cats || '').split('||');
            card.style.display = (cat === 'all' || cats.indexOf(cat) !== -1) ? '' : 'none';
          });
        });
      });
    });
  </script>
</BaseLayout>
