---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content } from '../about.md';

const title = '关于';
const description = '关于张坤：独立游戏开发者 / AI 与算法爱好者。在这里了解我的方向、技能栈和联系方式。';
---

<BaseLayout title={title} description={description}>
  <article class="post-detail container-narrow">
    <header class="post-detail-header">
      <h1 class="post-detail-title">关于</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
