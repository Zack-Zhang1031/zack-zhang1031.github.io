---
/**
 * LotSystem — three independent 100-lot collections (观音 / 吕祖 / 关帝),
 * optional divination cups, and immediate repeat draws.
 *
 * Everything computes in-browser with injected crypto randomness; results
 * live only in memory and vanish on refresh. Modern notes are original
 * hedged writing; classical texts are public-domain transcriptions.
 */
import SoundControl from './SoundControl.astro';
---

<div class="jing-lots" id="jing-lots-app">
  <div class="jing-lot-tabs" role="tablist" aria-label="签种">
    <button type="button" role="tab" id="lot-tab-guanyin" aria-controls="lot-panel" aria-selected="true">观音灵签</button>
    <button type="button" role="tab" id="lot-tab-luzu" aria-controls="lot-panel" aria-selected="false">吕祖灵签</button>
    <button type="button" role="tab" id="lot-tab-guandi" aria-controls="lot-panel" aria-selected="false">关帝灵签</button>
  </div>

  <section id="lot-panel" role="tabpanel" aria-labelledby="lot-tab-guanyin">
    <details class="jing-lot-source">
      <summary>签诗版本与来源</summary>
      <p id="lot-edition" class="jing-lot-edition"></p>
    </details>
    <p class="jing-lot-hint">
      静心默念所问，再按下抽签。签诗为古典文本转录，简释为本站原创的现代整理，
      只作文化参考，不构成任何现实建议。不保存、不联网，刷新即清。
    </p>
    <p class="jing-lot-ask">
      <label for="lot-question">所问何事（可不填；只存此刻，刷新即散）</label>
      <input id="lot-question" type="text" maxlength="20" placeholder="心中之事" autocomplete="off" />
    </p>
    <div class="jing-lot-actions">
      <button type="button" id="lot-draw" class="jing-btn jing-btn-primary">抽签</button>
      <button type="button" id="lot-cups" class="jing-btn" disabled>掷筊三回</button>
      <button type="button" id="lot-copy" class="jing-btn" disabled>复制 / 分享签文</button>
      <button type="button" id="lot-bookmark" class="jing-btn" disabled>存为书签图</button>
      <SoundControl layers={['rain', 'insects', 'tea']} />
    </div>
  </section>

  <div class="jing-lot-stage" id="lot-stage" data-phase="idle" aria-live="polite">
    <div class="jing-lot-visual" id="lot-visual" data-frame="0" data-collection="guanyin" role="img" aria-label="观音灵签签筒摇签动画">
      <div class="jing-lot-contact-shadow" aria-hidden="true"></div>
      <img id="lot-tube-image" class="jing-lot-frame-image" src="/jing/generated/lot/frames-safe/guanyin/frame-0.png" width="768" height="1152" alt="" />
      <canvas id="lot-animation-canvas" class="jing-lot-animation-canvas" width="768" height="1152" hidden aria-hidden="true"></canvas>
      <div id="lot-falling-stick" class="jing-lot-falling-stick" hidden aria-hidden="true">
        <img id="lot-falling-stick-image" src="/jing/generated/lot/selected-sticks/guanyin.png" alt="" />
        <output id="lot-rising-number" class="jing-lot-rising-number"></output>
      </div>
    </div>
    <ol class="jing-lot-progress" aria-label="抽签进度">
      <li data-lot-step="shaking">摇筒</li>
      <li data-lot-step="emerging">签出</li>
      <li data-lot-step="unfurling">展卷</li>
    </ol>
    <p class="jing-lot-stage-text" id="lot-stage-text" role="status">静心默念所问 · 点击下方抽签</p>
  </div>

  <div class="jing-lot-cleanse" id="lot-cleanse" hidden role="button" tabindex="0"
    aria-label="净手静心，点击继续抽签">
    <svg class="jing-cleanse-basin" viewBox="0 0 160 96" aria-hidden="true">
      <path d="M28 40 h104 l-8 34 a48 14 0 0 1 -88 0 z"
        fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1.4" />
      <ellipse cx="80" cy="40" rx="52" ry="10"
        fill="var(--jing-accent-soft)" stroke="var(--jing-accent)" stroke-width="1.2" />
      <g class="jing-cleanse-ripples" id="lot-cleanse-ripples"
        fill="none" stroke="var(--jing-accent)" stroke-width="1"></g>
    </svg>
    <p class="jing-cleanse-text">净手，静心。指尖掠过水面。</p>
    <p class="jing-cleanse-ready" id="lot-cleanse-ready" hidden>可以抽签了——点任意处继续。</p>
  </div>

  <div class="jing-lot-preview" id="lot-bookmark-preview" hidden role="dialog" aria-label="书签图预览">
    <img id="lot-bookmark-img" alt="签诗书签预览" />
    <div class="jing-lot-preview-actions">
      <button type="button" id="lot-bookmark-save" class="jing-btn jing-btn-primary">存下这张图</button>
      <button type="button" id="lot-bookmark-cancel" class="jing-btn">收起</button>
    </div>
  </div>

  <section id="lot-result" class="jing-lot-result" hidden aria-live="polite" tabindex="-1">
    <div class="jing-lot-mood" id="lot-mood" data-mood="guanyin" aria-hidden="true"></div>
    <header class="jing-lot-head">
      <p id="lot-title" class="jing-lot-title"></p>
      <p id="lot-grade" class="jing-lot-grade"></p>
      <p id="lot-question-echo" class="jing-lot-question" hidden></p>
    </header>
    <div class="jing-lot-verse-wrap">
      <blockquote id="lot-verse" class="jing-lot-verse"></blockquote>
      <span class="jing-stamp jing-lot-stamp" id="lot-stamp" aria-hidden="true"></span>
    </div>
    <p id="lot-allusion" class="jing-lot-allusion"></p>

    <details class="jing-lot-classical">
      <summary>古典辅文（公有领域转录）</summary>
      <dl id="lot-classical-list"></dl>
    </details>

    <div class="jing-lot-topics">
      <h3>现代简释（原创，仅供参考）</h3>
      <ul id="lot-topics-list"></ul>
    </div>

    <ul id="lot-cautions" class="jing-lot-cautions" hidden></ul>

    <div id="lot-cups-area" hidden>
      <h3>掷筊</h3>
      <p class="jing-lot-hint">若心中无问，筊不必掷。</p>
      <div id="lot-cups-visual" class="jing-cups-visual" aria-hidden="true"></div>
      <p id="lot-cups-result" class="jing-lot-cups"></p>
      <p class="jing-lot-hint">筊杯只是一种传统仪式参考，不会改变、也不覆盖上面这枝签。</p>
    </div>

    <p class="jing-freshness">不保存 · 不联网 · 刷新即清</p>
  </section>

  <section id="lot-session-history" class="jing-lot-session-history" hidden aria-labelledby="lot-session-title">
    <header><h2 id="lot-session-title">本次签录</h2><span>只留当前页面 · 刷新即清</span></header>
    <ol id="lot-session-list"></ol>
  </section>
</div>

<script>
  import { GUANYIN_COLLECTION } from '../../data/jing/lots/guanyin';
  import { LUZU_COLLECTION } from '../../data/jing/lots/luzu';
  import { GUANDI_COLLECTION } from '../../data/jing/lots/guandi';
  import { drawLot, throwCups } from '../../lib/jing/lots/draw';
  import { frameBlendAt, LOT_MOTION_PROFILES, phaseAt, type LotMotionCollectionId, type LotMotionPhase } from '../../lib/jing/lot-motion';
  import { cryptoRandomSource } from '../../lib/jing/random';
  import { loadSettings } from '../../lib/jing/settings';
  import { FX_SRC, LAYER_SRC, playFx, registerAmbience, setAmbienceVolume } from '../../lib/jing/sound-fx';
  import type { DrawResult, LotCollection } from '../../lib/jing/lots/types';

  const app = document.getElementById('jing-lots-app');
  if (app) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const COLLECTIONS: Record<string, LotCollection> = {
      guanyin: GUANYIN_COLLECTION,
      luzu: LUZU_COLLECTION,
      guandi: GUANDI_COLLECTION,
    };
    let current: LotCollection = GUANYIN_COLLECTION;
    let lastDraw: DrawResult | null = null;
    let pendingDraw: DrawResult | null = null;
    let cupsThrown = false;
    type SessionDraw = { draw: DrawResult; question: string; drawnAt: Date };
    const sessionDraws: SessionDraw[] = [];

    const resultEl = $('lot-result');
    const stageEl = $('lot-stage');
    const stageText = $('lot-stage-text');
    const drawBtn = $('lot-draw') as HTMLButtonElement;
    let animating = false;
    const lotVisual = $('lot-visual');
    const lotTubeImage = $('lot-tube-image') as HTMLImageElement;
    const lotCanvas = $('lot-animation-canvas') as HTMLCanvasElement;
    const lotCanvasContext = lotCanvas.getContext('2d', { alpha: true });
    const fallingStick = $('lot-falling-stick');
    const fallingStickImage = $('lot-falling-stick-image') as HTMLImageElement;
    let lotAnimationFrame = 0;
    let activeStageMotion: Animation | null = null;
    let activeStickMotion: Animation | null = null;
    let lotRunId = 0;

    const reducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || loadSettings(localStorage).settings.motion === 'reduce';

    /* ---- 声音：动作音效 + 可选氛围层（均需用户开启） ---- */
    let soundOn = false;
    let soundVol = 0.6;
    let layerAudio: HTMLAudioElement | null = null;
    let layerId: string | null = null;

    const syncLayer = (enabled: boolean, volume: number, layer: string | null) => {
      if (!enabled || !layer) {
        layerAudio?.pause();
        return;
      }
      if (!layerAudio || layerId !== layer) {
        layerAudio?.pause();
        layerAudio = new Audio(LAYER_SRC[layer]);
        layerAudio.loop = true;
        layerId = layer;
        registerAmbience(layerAudio);
      }
      setAmbienceVolume(layerAudio, volume * 0.4);
      void layerAudio.play().catch(() => {});
    };

    app.querySelector('[data-sound-control]')?.addEventListener('jing:sound', (e) => {
      const { enabled, volume, layer } = (e as CustomEvent).detail as
        { enabled: boolean; volume: number; layer: string | null };
      soundOn = enabled;
      soundVol = volume;
      syncLayer(enabled, volume, layer);
    });

    const fx = (src: string, scale = 1, delayMs = 0) => {
      if (soundOn) playFx(src, soundVol * scale, delayMs);
    };

    const hasIntegratedStickSequence = (collectionId: string) =>
      collectionId === 'guanyin' || collectionId === 'luzu' || collectionId === 'guandi';
    const frameSrc = (collectionId: string, frame: number) =>
      `/jing/generated/lot/frames-safe/${collectionId}/frame-${frame}.png`;
    const frameCache = new Map<string, Promise<HTMLImageElement[]>>();
    const decodeImage = async (image: HTMLImageElement) => {
      try {
        await image.decode();
      } catch {
        if (!image.complete) {
          await new Promise<void>((resolve, reject) => {
            image.addEventListener('load', () => resolve(), { once: true });
            image.addEventListener('error', () => reject(new Error(`无法载入抽签帧：${image.src}`)), { once: true });
          });
        }
      }
      if (!image.naturalWidth) throw new Error(`抽签帧为空：${image.src}`);
    };
    const preloadFrames = (collectionId: string) => {
      const cached = frameCache.get(collectionId);
      if (cached) return cached;
      const profile = LOT_MOTION_PROFILES[collectionId as LotMotionCollectionId];
      const frameCount = profile.cues.at(-1)!.frame + 1;
      const loading = Promise.all(Array.from({ length: frameCount }, async (_, frame) => {
        const image = new Image();
        image.decoding = 'async';
        image.src = frameSrc(collectionId, frame);
        await decodeImage(image);
        return image;
      }));
      frameCache.set(collectionId, loading);
      return loading;
    };
    const setVisualFrame = (frame: number) => {
      lotVisual.dataset.frame = String(frame);
      lotTubeImage.src = frameSrc(current.id, frame);
    };

    const stopVisualTimeline = (preserveLandedStick = false) => {
      cancelAnimationFrame(lotAnimationFrame);
      lotAnimationFrame = 0;
      activeStageMotion?.cancel();
      activeStageMotion = null;
      activeStickMotion?.cancel();
      activeStickMotion = null;
      if (!preserveLandedStick) {
        fallingStick.hidden = true;
        fallingStick.dataset.landed = 'false';
        fallingStick.style.removeProperty('--lot-land-x');
        fallingStick.style.removeProperty('--lot-land-y');
      }
      lotVisual.dataset.canvasReady = 'false';
      lotCanvas.hidden = true;
      lotCanvasContext?.clearRect(0, 0, lotCanvas.width, lotCanvas.height);
    };

    const renderCanvasBlend = (frames: HTMLImageElement[], elapsed: number, collectionId: LotMotionCollectionId) => {
      if (!lotCanvasContext) return;
      const blend = frameBlendAt(LOT_MOTION_PROFILES[collectionId], elapsed);
      const visibleFrame = blend.mix >= 0.5 ? blend.nextFrame : blend.frame;
      lotCanvasContext.clearRect(0, 0, lotCanvas.width, lotCanvas.height);
      // Each generated frame already contains the complete vessel and selected
      // stick. Cross-fading adjacent frames would briefly show two sticks, so
      // switch once near the end of the cue instead of dissolving the images.
      lotCanvasContext.globalAlpha = 1;
      lotCanvasContext.drawImage(frames[visibleFrame], 0, 0, lotCanvas.width, lotCanvas.height);
      if (lotVisual.dataset.frame !== String(visibleFrame)) setVisualFrame(visibleFrame);
    };

    const phaseCopy: Record<LotMotionPhase, string> = {
      shaking: '签筒徐摇 · 竹签相击',
      emerging: '一签自筒心徐出 · 签号已定',
      landing: '签离筒口 · 落向案前',
      unfurling: '签条已安放 · 即将展卷',
    };

    const playFallingStick = (collectionId: LotMotionCollectionId, duration: number) => {
      const rect = lotVisual.getBoundingClientRect();
      const landX = rect.width * 0.16;
      const landY = rect.height * 0.74;
      fallingStickImage.src = `/jing/generated/lot/selected-sticks/${collectionId}.png`;
      fallingStick.style.setProperty('--lot-land-x', `${landX}px`);
      fallingStick.style.setProperty('--lot-land-y', `${landY}px`);
      fallingStick.dataset.landed = 'false';
      fallingStick.hidden = false;
      activeStickMotion?.cancel();
      activeStickMotion = fallingStick.animate([
        { offset: 0, transform: 'translate(-50%, 0) rotate(1deg)' },
        { offset: 0.14, transform: 'translate(calc(-50% + 18px), -10px) rotate(8deg)', easing: 'cubic-bezier(.2,.7,.3,1)' },
        { offset: 0.72, transform: `translate(calc(-50% + ${landX}px), ${landY - 12}px) rotate(77deg)`, easing: 'cubic-bezier(.42,0,.92,.45)' },
        { offset: 0.83, transform: `translate(calc(-50% + ${landX}px), ${landY}px) rotate(83deg)`, easing: 'cubic-bezier(.15,.75,.3,1)' },
        { offset: 0.91, transform: `translate(calc(-50% + ${landX - 3}px), ${landY - 8}px) rotate(79deg)`, easing: 'ease-out' },
        { offset: 1, transform: `translate(calc(-50% + ${landX}px), ${landY}px) rotate(82deg)` },
      ], { duration, easing: 'linear', fill: 'forwards' });
    };

    const playVisualTimeline = async (collectionId: LotMotionCollectionId, runId: number) => {
      const profile = LOT_MOTION_PROFILES[collectionId];
      const frames = await preloadFrames(collectionId);
      if (runId !== lotRunId) return false;
      if (!lotCanvasContext) throw new Error('浏览器不支持抽签画布');

      lotCanvas.hidden = false;
      lotVisual.dataset.canvasReady = 'true';
      renderCanvasBlend(frames, 0, collectionId);
      activeStageMotion = lotVisual.animate([...profile.keyframes], {
        duration: profile.duration,
        easing: 'linear',
      });

      return new Promise<boolean>((resolve) => {
        let startedAt: number | null = null;
        let currentPhase: LotMotionPhase = 'shaking';
        let fallStarted = false;
        let landed = false;

        const tick = (now: number) => {
          if (runId !== lotRunId) {
            resolve(false);
            return;
          }
          startedAt ??= now;
          const elapsed = Math.min(profile.duration, now - startedAt);
          renderCanvasBlend(frames, elapsed, collectionId);

          const nextPhase = phaseAt(profile, elapsed);
          if (nextPhase !== currentPhase) {
            currentPhase = nextPhase;
            stageEl.dataset.phase = nextPhase;
            stageText.textContent = phaseCopy[nextPhase];
          }
          if (!hasIntegratedStickSequence(collectionId) && !fallStarted && elapsed >= profile.fallAt) {
            fallStarted = true;
            playFallingStick(collectionId, profile.landAt - profile.fallAt);
          }
          if (!landed && elapsed >= profile.landAt) {
            landed = true;
            fallingStick.dataset.landed = 'true';
            fx(FX_SRC.cupsDrop, 0.4);
          }
          if (elapsed >= profile.duration) {
            resolve(true);
            return;
          }
          lotAnimationFrame = requestAnimationFrame(tick);
        };
        lotAnimationFrame = requestAnimationFrame(tick);
      });
    };

    const editionText = () =>
      `${current.name} · ${current.edition} · 数据修订 ${current.revision}`;

    const renderEdition = () => {
      stopVisualTimeline();
      $('lot-edition').textContent = editionText();
      $('lot-panel').setAttribute('aria-labelledby', `lot-tab-${current.id}`);
      setVisualFrame(0);
      void preloadFrames(current.id).catch(() => {});
      lotVisual.dataset.collection = current.id;
      fallingStickImage.src = `/jing/generated/lot/selected-sticks/${current.id}.png`;
      lotVisual.setAttribute('aria-label', `${current.name}签筒摇签动画`);
    };

    /* ---- tabs ---- */
    const tabs = Array.from(app.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const setTabsDisabled = (disabled: boolean) => tabs.forEach((tab) => { tab.disabled = disabled; });
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        for (const t of tabs) t.setAttribute('aria-selected', String(t === tab));
        current = COLLECTIONS[tab.id.replace('lot-tab-', '')];
        renderEdition();
      });
    }

    /* ---- rendering ---- */
    const renderSessionHistory = () => {
      const history = $('lot-session-history');
      const list = $('lot-session-list');
      history.hidden = sessionDraws.length === 0;
      list.innerHTML = sessionDraws.map((entry, index) => {
        const collection = COLLECTIONS[entry.draw.collectionId];
        const time = entry.drawnAt.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
        return `<li><button type="button" data-lot-history="${index}">`
          + `<b>${collection.name} · 第 ${entry.draw.lot.number} 签</b>`
          + `<span>${entry.draw.lot.title} · ${time}</span></button></li>`;
      }).join('');
    };

    const renderDraw = (draw: DrawResult, askedQuestion?: string) => {
      const lot = draw.lot;
      const drawCollection = COLLECTIONS[draw.collectionId];
      $('lot-mood').setAttribute('data-mood', drawCollection.id);
      $('lot-title').textContent = `第 ${lot.number} 签 · ${lot.title}`;
      const ganzhi = lot.ganzhi ? ` · ${lot.ganzhi}` : '';
      $('lot-grade').textContent = `${drawCollection.name} · ${lot.grade}${ganzhi}`;
      $('lot-stamp').textContent = `第${lot.number}签`;
      const question = askedQuestion ?? ($('lot-question') as HTMLInputElement).value.trim();
      const echo = $('lot-question-echo');
      echo.textContent = question ? `为「${question}」问` : '';
      echo.hidden = !question;
      $('lot-verse').innerHTML = lot.verse.map((line) => `<p>${line}</p>`).join('');
      $('lot-allusion').textContent = lot.allusion;
      $('lot-classical-list').innerHTML = Object.entries(lot.classical)
        .filter(([, value]) => value)
        .map(([key, value]) => `<div><dt>${key}</dt><dd>${value}</dd></div>`)
        .join('');
      $('lot-topics-list').innerHTML = lot.topics
        .map((topic) => `<li><strong>${topic.theme}</strong>：${topic.text}</li>`)
        .join('');
      const cautionsEl = $('lot-cautions');
      cautionsEl.innerHTML = lot.cautions.map((c) => `<li>${c}</li>`).join('');
      cautionsEl.hidden = lot.cautions.length === 0;
      $('lot-cups-area').hidden = true;
      $('lot-cups-visual').innerHTML = '';
      cupsThrown = false;
      ($('lot-cups') as HTMLButtonElement).disabled = false;
      ($('lot-copy') as HTMLButtonElement).disabled = false;
      ($('lot-bookmark') as HTMLButtonElement).disabled = false;
      resultEl.hidden = false;
      /* 展卷：重触发 clip-path 展开动画 */
      resultEl.classList.remove('is-unfurl');
      void resultEl.offsetWidth;
      resultEl.classList.add('is-unfurl');
      resultEl.focus({ preventScroll: true });
      resultEl.scrollIntoView({ block: 'start', behavior: reducedMotion() ? 'auto' : 'smooth' });
    };

    const doDraw = () => {
      lastDraw = pendingDraw ?? drawLot(current, cryptoRandomSource);
      pendingDraw = null;
      const question = ($('lot-question') as HTMLInputElement).value.trim();
      sessionDraws.unshift({ draw: lastDraw, question, drawnAt: new Date() });
      if (sessionDraws.length > 8) sessionDraws.length = 8;
      renderSessionHistory();
      renderDraw(lastDraw, question);
      fx(FX_SRC.paperUnfurl, 0.55);
      drawBtn.disabled = false;
      drawBtn.textContent = '重新抽签';
      setTabsDisabled(false);
      app.classList.remove('is-ritual-active');
    };

    const settleStage = (hasResult: boolean) => {
      stopVisualTimeline(hasResult && fallingStick.dataset.landed === 'true');
      stageEl.hidden = false;
      stageEl.classList.remove('is-playing');
      stageEl.dataset.phase = hasResult ? 'settled' : 'idle';
      const settledFrame = LOT_MOTION_PROFILES[current.id as LotMotionCollectionId].cues.at(-1)!.frame;
      setVisualFrame(hasResult && hasIntegratedStickSequence(current.id) ? settledFrame : 0);
      stageText.textContent = hasResult
        ? '签筒已归位 · 签文展于右侧'
        : '静心默念所问 · 点击下方抽签';
    };

    const runShake = async () => {
      animating = true;
      const runId = ++lotRunId;
      const collectionId = current.id as LotMotionCollectionId;
      stopVisualTimeline();
      pendingDraw = drawLot(current, cryptoRandomSource);
      $('lot-rising-number').textContent = `第${pendingDraw.lot.number}签`;
      drawBtn.disabled = true;
      drawBtn.textContent = '摇签中…';
      setTabsDisabled(true);
      app.classList.add('is-ritual-active');
      fx(FX_SRC.shakeSticks, 0.9);
      resultEl.hidden = true;
      stageEl.hidden = false;
      stageEl.dataset.phase = 'shaking';
      setVisualFrame(0);
      stageText.textContent = '签筒徐摇 · 竹签相击';
      stageEl.classList.add('is-playing');
      /* 舞台在面板下方，摇签时带进视野中央 */
      stageEl.scrollIntoView({ block: 'center', behavior: reducedMotion() ? 'auto' : 'smooth' });
      try {
        const completed = await playVisualTimeline(collectionId, runId);
        if (!completed || runId !== lotRunId) return;
      } catch (error) {
        // The traditional data draw must remain usable if a local decorative
        // frame is damaged or Canvas is unavailable.
        console.warn('抽签动画已降级为静态结果', error);
      }
      if (runId !== lotRunId) return;
      animating = false;
      doDraw();
      settleStage(true);
    };

    /* ---- 净手：每次到访的第一次抽签，先净手静心 ---- */
    const cleanseEl = $('lot-cleanse');
    const cleanseReady = $('lot-cleanse-ready');
    const cleanseRipples = document.getElementById('lot-cleanse-ripples')!;
    let cleansed = false;
    let cleanseTimer: ReturnType<typeof setTimeout> | null = null;

    const finishCleanse = () => {
      if (cleanseEl.hidden) return;
      cleansed = true;
      if (cleanseTimer) { clearTimeout(cleanseTimer); cleanseTimer = null; }
      cleanseEl.hidden = true;
      runShake();
    };

    const startCleanse = () => {
      app.classList.add('is-ritual-active');
      cleanseEl.hidden = false;
      cleanseReady.hidden = true;
      /* 单击抽签即开始：净手作为短前奏自动衔接摇筒，不再要求第二次点击。 */
      cleanseEl.scrollIntoView({ block: 'center', behavior: reducedMotion() ? 'auto' : 'smooth' });
      cleanseTimer = setTimeout(finishCleanse, 520);
    };

    cleanseEl.addEventListener('click', finishCleanse);
    cleanseEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); finishCleanse(); }
    });
    cleanseEl.addEventListener('pointermove', (e) => {
      const svg = cleanseEl.querySelector('svg');
      if (!svg) return;
      const ctm = svg.getScreenCTM();
      if (!ctm) return;
      const pt = new DOMPoint(e.clientX, e.clientY).matrixTransform(ctm.inverse());
      if (pt.y < 20 || pt.y > 52) return; // 只在水面起澜
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('cx', String(pt.x));
      c.setAttribute('cy', '40');
      c.setAttribute('r', '3');
      c.setAttribute('class', 'jing-cleanse-ripple');
      cleanseRipples.appendChild(c);
      setTimeout(() => c.remove(), 1400);
    });

    $('lot-draw').addEventListener('click', () => {
      if (animating) return;
      if (reducedMotion()) {
        app.classList.add('is-ritual-active');
        pendingDraw = drawLot(current, cryptoRandomSource);
        doDraw();
        settleStage(true);
        return;
      }
      if (!cleansed) {
        startCleanse();
        return;
      }
      runShake();
    });

    $('lot-cups').addEventListener('click', () => {
      if (!lastDraw || cupsThrown) return;
      cupsThrown = true;
      const throws = throwCups(cryptoRandomSource);
      const label = { sheng: '圣筊', xiao: '笑筊', yin: '阴筊' } as const;
      /* 筊杯图示：圣=一俯一仰，笑=两仰，阴=两俯；逐回翻转落下 */
      const cup = (down: boolean) =>
        `<path d="M2 16 A10 10 0 0 1 22 16 A7 7 0 0 0 2 16 Z"
           transform="rotate(${down ? 180 : 0} 12 15)" />`;
      $('lot-cups-visual').innerHTML = throws
        .map((t, i) => {
          const [a, b] = t === 'sheng' ? [false, true] : t === 'xiao' ? [false, false] : [true, true];
          return `<svg class="jing-cup-pair" viewBox="0 0 48 38" style="animation-delay:${i * 0.4 + 0.4}s;--tilt:${[-2, 1.6, -1.2][i]}deg">
            <g transform="translate(2 2)">${cup(a)}</g>
            <g transform="translate(24 2)">${cup(b)}</g>
            <text x="24" y="35" text-anchor="middle">${label[t]}</text></svg>`;
        })
        .join('');
      $('lot-cups-result').textContent =
        `三回依次为：${throws.map((t) => label[t]).join('、')}`;
      throws.forEach((_, i) => fx(FX_SRC.cupsDrop, 0.7, i * 400 + 400));
      $('lot-cups-area').hidden = false;
      ($('lot-cups') as HTMLButtonElement).disabled = true;
    });

    $('lot-session-list').addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-lot-history]');
      if (!button) return;
      const entry = sessionDraws[Number(button.dataset.lotHistory)];
      if (!entry) return;
      lastDraw = entry.draw;
      current = COLLECTIONS[entry.draw.collectionId];
      ($('lot-question') as HTMLInputElement).value = entry.question;
      tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.id === `lot-tab-${current.id}`)));
      renderEdition();
      renderDraw(entry.draw, entry.question);
    });

    $('lot-copy').addEventListener('click', async () => {
      if (!lastDraw) return;
      const lot = lastDraw.lot;
      const drawCollection = COLLECTIONS[lastDraw.collectionId];
      const summary = [
        `${drawCollection.name} 第 ${lot.number} 签（${lot.grade}）${lot.title}`,
        ...lot.verse,
        `典故：${lot.allusion}`,
        ...lot.topics.map((t) => `${t.theme}：${t.text}`),
        '—— 静心堂 · 本地研习，签文只作文化参考',
      ].join('\n');
      try {
        await navigator.clipboard.writeText(summary);
        ($('lot-copy') as HTMLButtonElement).textContent = '已复制';
        setTimeout(() => { ($('lot-copy') as HTMLButtonElement).textContent = '复制签文摘要'; }, 1600);
      } catch {
        ($('lot-copy') as HTMLButtonElement).textContent = '复制失败';
      }
    });

    /* ---- 书签图：水墨底衬 + canvas 竖排，先预览再存 ---- */
    const buildBookmark = async (): Promise<HTMLCanvasElement | null> => {
      if (!lastDraw) return null;
      const lot = lastDraw.lot;
      const drawCollection = COLLECTIONS[lastDraw.collectionId];
      const canvas = document.createElement('canvas');
      canvas.width = 480;
      canvas.height = 1080;
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;

      // 宣纸底
      ctx.fillStyle = '#f6f1e4';
      ctx.fillRect(0, 0, 480, 1080);

      // 纯 Canvas 意境底衬：墨晕、远山与向下渐隐，不读取背景图片。
      const ink = ctx.createRadialGradient(240, 130, 12, 240, 160, 330);
      ink.addColorStop(0, 'rgba(72, 57, 38, 0.2)');
      ink.addColorStop(0.58, 'rgba(91, 73, 48, 0.08)');
      ink.addColorStop(1, 'rgba(246, 241, 228, 0)');
      ctx.fillStyle = ink;
      ctx.fillRect(0, 0, 480, 520);
      ctx.save();
      ctx.globalAlpha = 0.13;
      ctx.fillStyle = '#463b2d';
      ctx.beginPath();
      ctx.moveTo(0, 318);
      ctx.bezierCurveTo(72, 238, 126, 284, 192, 218);
      ctx.bezierCurveTo(255, 154, 319, 282, 388, 210);
      ctx.bezierCurveTo(427, 174, 458, 232, 480, 196);
      ctx.lineTo(480, 390);
      ctx.lineTo(0, 390);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
      const fade = ctx.createLinearGradient(0, 180, 0, 560);
      fade.addColorStop(0, 'rgba(246, 241, 228, 0)');
      fade.addColorStop(1, 'rgba(246, 241, 228, 1)');
      ctx.fillStyle = fade;
      ctx.fillRect(0, 180, 480, 380);

      // 双线框
      ctx.strokeStyle = '#b8934a';
      ctx.lineWidth = 3;
      ctx.strokeRect(16, 16, 448, 1048);
      ctx.lineWidth = 1;
      ctx.strokeRect(26, 26, 428, 1028);

      // 抬头：套名 · 等第
      ctx.fillStyle = '#6f6148';
      ctx.font = '22px "Songti SC", "SimSun", serif';
      ctx.textAlign = 'center';
      ctx.fillText(`${drawCollection.name} · ${lot.grade}`, 240, 74);

      // 签题
      ctx.fillStyle = '#3a3227';
      ctx.font = '30px "Kaiti SC", "STKaiti", "KaiTi", serif';
      ctx.fillText(`第 ${lot.number} 签 · ${lot.title}`, 240, 122);

      // 竖排签诗：自右向左四列（下移到纸区）
      ctx.font = '34px "Kaiti SC", "STKaiti", "KaiTi", serif';
      ctx.fillStyle = '#3a3227';
      ctx.textAlign = 'center';
      lot.verse.forEach((line, col) => {
        const x = 396 - col * 88;
        [...line].forEach((ch, row) => {
          ctx.fillText(ch, x, 620 + row * 62);
        });
      });

      // 落款 + 朱印
      ctx.textAlign = 'left';
      ctx.fillStyle = '#8a7a5f';
      ctx.font = '20px "Songti SC", "SimSun", serif';
      ctx.fillText('静心堂 · 本地研习 · 签文只作文化参考', 48, 1006);
      ctx.save();
      ctx.translate(408, 950);
      ctx.rotate(-0.035);
      ctx.strokeStyle = '#a8433a';
      ctx.lineWidth = 3;
      ctx.strokeRect(0, 0, 58, 58);
      ctx.fillStyle = '#a8433a';
      ctx.font = '30px "Kaiti SC", "STKaiti", "KaiTi", serif';
      ctx.textAlign = 'center';
      ctx.fillText('静', 29, 41);
      ctx.restore();

      return canvas;
    };

    $('lot-bookmark').addEventListener('click', async () => {
      const canvas = await buildBookmark();
      if (!canvas) return;
      ($('lot-bookmark-img') as HTMLImageElement).src = canvas.toDataURL('image/png');
      $('lot-bookmark-preview').hidden = false;
    });

    $('lot-bookmark-save').addEventListener('click', () => {
      const src = ($('lot-bookmark-img') as HTMLImageElement).src;
      if (!src || !lastDraw) return;
      const a = document.createElement('a');
      a.download = `jing-lot-${lastDraw.collectionId}-${lastDraw.lot.number}.png`;
      a.href = src;
      a.click();
      $('lot-bookmark-preview').hidden = true;
    });

    $('lot-bookmark-cancel').addEventListener('click', () => {
      $('lot-bookmark-preview').hidden = true;
    });

    window.addEventListener('pagehide', () => {
      lotRunId += 1;
      stopVisualTimeline();
    }, { once: true });

    renderEdition();
  }
</script>

