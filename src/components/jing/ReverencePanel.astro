---
/**
 * ReverencePanel — guided, non-gamified reverence flow for one tradition.
 *
 * Flow: select a single gesture or complete three-bow sequence -> start ->
 * typed ritual steps -> neutral completion copy. Sacred images live outside
 * this panel and are never controls. With reduced motion, poses advance
 * through explicit static steps instead of timed frame changes.
 */
import SoundControl from './SoundControl.astro';
import type { Tradition } from '../../data/jing/figures';

interface Props {
  tradition: Tradition;
}

const { tradition } = Astro.props;
const label = tradition === 'buddhist' ? '开始完整三拜' : '开始完整拱手礼';
const gestures = tradition === 'buddhist'
  ? [
      { id: 'complete', name: '完整三拜', desc: '合掌、跪拜、起身，礼敬三次' },
      { id: 'palms', name: '合掌', desc: '双手合掌，收摄身心' },
      { id: 'bow', name: '低头', desc: '低首致敬，片刻安住' },
      { id: 'kneel', name: '跪拜', desc: '缓身俯礼，量力而行' },
      { id: 'return', name: '回礼', desc: '起身合掌，回到当下' },
    ]
  : [
      { id: 'complete', name: '完整拱手礼', desc: '正身、拱手、躬身、礼敬、复位' },
      { id: 'hands', name: '拱手', desc: '双手相抱，端身正立' },
      { id: 'bow', name: '躬身', desc: '俯身致敬，动作徐缓' },
      { id: 'respect', name: '礼敬', desc: '三息一礼，复归自然' },
      { id: 'return', name: '回礼', desc: '缓缓起身，双手复位' },
    ];
---

<div
  class="jing-reverence"
  id={`reverence-${tradition}`}
  data-tradition={tradition}
  data-action={gestures[0].id}
>
  <div class="jing-reverence-start" data-stage="start">
    <p class="jing-reverence-guide">选择一种礼仪，动作以舒适、安稳为度。</p>
    <div class="jing-gesture-options" role="list" aria-label="礼敬动作">
      {gestures.map((gesture, index) => (
        <button
          type="button"
          class:list={['jing-gesture-option', index === 0 && 'is-selected']}
          data-gesture={gesture.id}
          data-label={gesture.name}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <b>{gesture.name}</b><small>{gesture.desc}</small>
        </button>
      ))}
    </div>
    <button type="button" class="jing-btn jing-reverence-begin">{label}</button>
    <SoundControl layers={['rain', 'insects', 'tea']} />
  </div>

  <div class="jing-reverence-phases" data-stage="phases" hidden>
    <div class="jing-scene" data-scene={tradition} aria-hidden="true">
      {tradition === 'buddhist' ? (
        <svg class="jing-scene-svg" viewBox="0 0 160 120">
          <!-- 香烟 -->
          <g class="jing-smoke" fill="none" stroke="var(--jing-text-dim)" stroke-width="1.5" stroke-linecap="round">
            <path class="jing-smoke-wisp w1" d="M72 74 C 70 62, 76 54, 72 42 C 68 32, 74 24, 71 14" />
            <path class="jing-smoke-wisp w2" d="M84 74 C 86 62, 80 52, 85 40 C 89 30, 83 22, 86 12" />
          </g>
          <!-- 香 -->
          <line x1="72" y1="76" x2="72" y2="92" stroke="var(--jing-vermilion)" stroke-width="1.6" />
          <line x1="84" y1="76" x2="84" y2="92" stroke="var(--jing-vermilion)" stroke-width="1.6" />
          <circle class="jing-ember" cx="72" cy="75" r="1.8" fill="var(--jing-vermilion)" />
          <circle class="jing-ember e2" cx="84" cy="75" r="1.8" fill="var(--jing-vermilion)" />
          <!-- 烛火 -->
          <g class="jing-candle">
            <rect x="37" y="90" width="6" height="16" rx="1.5"
              fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1" />
            <path class="jing-flame f1" d="M40 90 C 37.5 86, 38.5 82, 40 79 C 41.5 82, 42.5 86, 40 90 Z"
              fill="var(--jing-vermilion)" />
          </g>
          <g class="jing-candle">
            <rect x="108" y="90" width="6" height="16" rx="1.5"
              fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1" />
            <path class="jing-flame f2" d="M111 90 C 108.5 86, 109.5 82, 111 79 C 112.5 82, 113.5 86, 111 90 Z"
              fill="var(--jing-vermilion)" />
          </g>
          <!-- 炉 -->
          <path d="M52 92 h52 l-5 14 a24 8 0 0 1 -42 0 z"
            fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1.4" />
          <!-- 莲 -->
          <g class="jing-lotus" stroke="var(--jing-accent)" stroke-width="1.2" fill="var(--jing-accent-soft)">
            <path class="jing-petal p1" d="M128 108 C 120 100, 120 90, 128 84 C 136 90, 136 100, 128 108 Z" />
            <path class="jing-petal p2" d="M128 108 C 118 106, 112 98, 114 90 C 122 92, 128 98, 128 108 Z" />
            <path class="jing-petal p3" d="M128 108 C 138 106, 144 98, 142 90 C 134 92, 128 98, 128 108 Z" />
          </g>
        </svg>
      ) : (
        <svg class="jing-scene-svg" viewBox="0 0 160 120">
          <!-- 云气 -->
          <g class="jing-cloud" fill="none" stroke="var(--jing-text-dim)" stroke-width="1.1" stroke-linecap="round">
            <path d="M8 26 Q 22 18, 36 26 T 64 26" />
            <path d="M96 16 Q 108 10, 120 16 T 152 16" />
          </g>
          <!-- 太极：外层定位、内层自转（CSS 动画会覆盖 attribute transform，不能同层） -->
          <g class="jing-taiji" transform="translate(56 52)">
            <g class="jing-taiji-spin">
              <circle r="26" fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1.4" />
              <path d="M0 -26 A 26 26 0 0 1 0 26 A 13 13 0 0 1 0 0 A 13 13 0 0 0 0 -26 Z" fill="var(--jing-accent)" />
              <circle cy="-13" r="3.2" fill="var(--jing-accent)" />
              <circle cy="13" r="3.2" fill="var(--jing-bg-card)" />
            </g>
          </g>
          <!-- 太极水面倒影 -->
          <g class="jing-taiji-echo" transform="translate(0 128.8) scale(1 -0.4)" opacity="0.13">
            <g transform="translate(56 52)">
              <circle r="26" fill="none" stroke="var(--jing-accent)" stroke-width="1.6" />
              <path d="M0 -26 A 26 26 0 0 1 0 26 A 13 13 0 0 1 0 0 A 13 13 0 0 0 0 -26 Z" fill="var(--jing-accent)" />
            </g>
          </g>
          <!-- 烛火 -->
          <g class="jing-candle">
            <rect x="33" y="94" width="6" height="16" rx="1.5"
              fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1" />
            <path class="jing-flame f1" d="M36 94 C 33.5 90, 34.5 86, 36 83 C 37.5 86, 38.5 90, 36 94 Z"
              fill="var(--jing-vermilion)" />
          </g>
          <g class="jing-candle">
            <rect x="73" y="94" width="6" height="16" rx="1.5"
              fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1" />
            <path class="jing-flame f2" d="M76 94 C 73.5 90, 74.5 86, 76 83 C 77.5 86, 78.5 90, 76 94 Z"
              fill="var(--jing-vermilion)" />
          </g>
          <!-- 云烟 -->
          <g class="jing-smoke" fill="none" stroke="var(--jing-text-dim)" stroke-width="1.5" stroke-linecap="round">
            <path class="jing-smoke-wisp w1" d="M104 86 C 112 80, 108 70, 116 64 C 124 58, 120 48, 128 42" />
            <path class="jing-smoke-wisp w2" d="M116 92 C 126 88, 124 76, 134 70 C 142 65, 140 56, 148 50" />
          </g>
        </svg>
      )}
    </div>
    <div class="jing-breath-circle" aria-hidden="true"></div>
    <div class="jing-ripples" aria-hidden="true"></div>
    <p class="jing-phase-text" role="status" aria-live="polite"></p>
    <div
      class="jing-ritual-progress"
      role="progressbar"
      aria-label="礼敬进度"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <span aria-hidden="true"><i></i></span>
      <output>准备开始</output>
    </div>
    <div class="jing-reverence-phase-actions">
      <button type="button" class="jing-btn jing-phase-next" hidden>继续</button>
      <button type="button" class="jing-btn jing-reverence-stop">停止礼敬</button>
    </div>
  </div>

  <div class="jing-reverence-done" data-stage="done" hidden>
    <p class="jing-reverence-end">礼敬已毕。愿此刻的安静，伴随你接下来的时光。</p>
    <button type="button" class="jing-btn jing-reverence-again">再礼一次</button>
  </div>
</div>

<script>
  import { AMBIENCE_BY_TRADITION, AMBIENCE_SRC } from '../../data/jing/figures';
  import { loadSettings } from '../../lib/jing/settings';
  import {
    createBuddhistRitualState,
    getBuddhistReducedSteps,
    getBuddhistRitualSequence,
    transitionBuddhistRitual,
    createTaoistRitualState,
    getTaoistReducedSteps,
    getTaoistRitualSequence,
    transitionTaoistRitual,
    type BuddhistRitualAction,
    type BuddhistRitualStep,
    type TaoistRitualAction,
    type TaoistRitualStep,
  } from '../../lib/jing/ritual-machine';
  import { LAYER_SRC, playFx, registerAmbience, setAmbienceVolume } from '../../lib/jing/sound-fx';

  document.querySelectorAll<HTMLElement>('.jing-reverence').forEach((root) => {
    const tradition = root.dataset.tradition as 'buddhist' | 'taoist';
    const stages = {
      start: root.querySelector<HTMLElement>('[data-stage="start"]')!,
      phases: root.querySelector<HTMLElement>('[data-stage="phases"]')!,
      done: root.querySelector<HTMLElement>('[data-stage="done"]')!,
    };
    const phaseText = root.querySelector<HTMLElement>('.jing-phase-text')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('.jing-phase-next')!;
    const circle = root.querySelector<HTMLElement>('.jing-breath-circle')!;
    const scene = root.querySelector<HTMLElement>('.jing-scene')!;
    const beginBtn = root.querySelector<HTMLButtonElement>('.jing-reverence-begin')!;
    const stopBtn = root.querySelector<HTMLButtonElement>('.jing-reverence-stop')!;
    const progressBar = root.querySelector<HTMLElement>('.jing-ritual-progress i')!;
    const progressText = root.querySelector<HTMLOutputElement>('.jing-ritual-progress output')!;
    const progressRoot = root.querySelector<HTMLElement>('.jing-ritual-progress')!;
    const gestureButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.jing-gesture-option'));
    let buddhistMachine = createBuddhistRitualState();
    let taoistMachine = createTaoistRitualState();

    gestureButtons.forEach((button) => {
      button.addEventListener('click', () => {
        gestureButtons.forEach((item) => {
          const selected = item === button;
          item.classList.toggle('is-selected', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        root.dataset.action = button.dataset.gesture || '';
        if (tradition === 'buddhist') {
          buddhistMachine = transitionBuddhistRitual(buddhistMachine, {
            type: 'SELECT',
            action: button.dataset.gesture as BuddhistRitualAction,
          });
          beginBtn.textContent = `开始${button.dataset.label || '礼佛'}`;
        } else {
          taoistMachine = transitionTaoistRitual(taoistMachine, {
            type: 'SELECT',
            action: button.dataset.gesture as TaoistRitualAction,
          });
          beginBtn.textContent = `开始${button.dataset.label || '敬道'}`;
        }
        root.dispatchEvent(new CustomEvent('jing:gesture', {
          bubbles: true,
          detail: { gesture: button.dataset.gesture, label: button.dataset.label },
        }));
      });
    });

    /* New visitors default to sound on; Audio.play() still respects each
       browser's autoplay policy and resumes from a trusted interaction. */
    let ambience: HTMLAudioElement[] = [];
    let soundOn = false;
    let soundVol = 0.6;
    let layerAudio: HTMLAudioElement | null = null;
    let layerId: string | null = null;
    const soundControl = root.querySelector('[data-sound-control]');
    soundControl?.addEventListener('jing:sound', (e) => {
      const { enabled, volume, layer } = (e as CustomEvent).detail as
        { enabled: boolean; volume: number; layer: string | null };
      soundOn = enabled;
      soundVol = volume;
      /* 烛火随声：有声时火焰的摇曳幅度随音量，无声更静 */
      scene.style.setProperty('--flame-amp', String(0.05 + (enabled ? volume * 0.12 : 0)));
      /* 雨声氛围下，道房云气压低、走得更慢 */
      if (tradition === 'taoist') scene.classList.toggle('is-rainy', enabled && layer === 'rain');
      if (enabled && ambience.length === 0) {
        ambience = AMBIENCE_BY_TRADITION[tradition].map((id) => {
          const audio = new Audio(AMBIENCE_SRC[id]);
          audio.loop = true;
          registerAmbience(audio);
          return audio;
        });
      }
      for (const audio of ambience) {
        setAmbienceVolume(audio, volume * 0.45);
        if (enabled) void audio.play().catch(() => {});
        else audio.pause();
      }
      /* 可选第二氛围层：雨 / 虫 / 茶 */
      if (!enabled || !layer) {
        layerAudio?.pause();
      } else {
        if (!layerAudio || layerId !== layer) {
          layerAudio?.pause();
          layerAudio = new Audio(LAYER_SRC[layer]);
          layerAudio.loop = true;
          layerId = layer;
          registerAmbience(layerAudio);
        }
        setAmbienceVolume(layerAudio, volume * 0.35);
        void layerAudio.play().catch(() => {});
      }
    });

    /* 每一礼过渡：有声状态下磬声一记 + 涟漪一圈。 */
    const PHASE_CHIME: Record<string, string> = {
      buddhist: AMBIENCE_SRC.chime,
      taoist: AMBIENCE_SRC['windchime'],
    };
    const playPhaseChime = () => {
      if (!soundOn) return;
      playFx(PHASE_CHIME[tradition], soundVol * 0.7);
    };

    const ripples = root.querySelector<HTMLElement>('.jing-ripples')!;
    const spawnRipple = () => {
      const r = document.createElement('span');
      r.className = 'jing-ripple';
      ripples.appendChild(r);
      setTimeout(() => r.remove(), 2200);
    };

    const showStage = (name: keyof typeof stages) => {
      (Object.keys(stages) as (keyof typeof stages)[]).forEach((k) => {
        stages[k].hidden = k !== name;
      });
    };

    let timers: ReturnType<typeof setTimeout>[] = [];
    const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };

    const reducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || loadSettings(localStorage).settings.motion === 'reduce';

    const settle = () => {
      stages.done.classList.remove('is-settled');
      void stages.done.offsetWidth;
      stages.done.classList.add('is-settled');
    };

    const finishRitual = () => {
      clearTimers();
      circle.classList.remove('is-animated');
      scene.classList.remove('is-animated');
      nextBtn.hidden = true;
      progressBar.style.width = '100%';
      progressRoot.setAttribute('aria-valuenow', '100');
      progressRoot.setAttribute('aria-valuetext', '礼敬完成');
      progressText.value = '礼敬完成';
      if (tradition === 'buddhist') {
        buddhistMachine = transitionBuddhistRitual(buddhistMachine, { type: 'COMPLETE' });
      } else {
        taoistMachine = transitionTaoistRitual(taoistMachine, { type: 'COMPLETE' });
      }
      showStage('done');
      settle();
      root.dispatchEvent(new CustomEvent('jing:ritual-done', { bubbles: true }));
    };

    type RitualStep = BuddhistRitualStep | TaoistRitualStep;

    const dispatchPose = (step: RitualStep, index: number, total: number) => {
      phaseText.textContent = step.label;
      const progress = total > 0 ? Math.round(((index + 1) / total) * 100) : 0;
      progressBar.style.width = `${progress}%`;
      progressRoot.setAttribute('aria-valuenow', String(progress));
      progressRoot.setAttribute('aria-valuetext', `第 ${index + 1} / ${total} 步`);
      progressText.value = `第 ${index + 1} / ${total} 步`;
      root.dispatchEvent(new CustomEvent('jing:ritual-pose', {
        bubbles: true,
        detail: { pose: step.pose, label: step.label, index, total, progress },
      }));
      if (step.mark === 'chime') playPhaseChime();
      if (step.mark === 'ripple' || step.mark === 'chime') spawnRipple();
    };

    const runStatic = (steps: readonly RitualStep[], index: number) => {
      circle.classList.remove('is-animated');
      scene.classList.remove('is-animated');
      if (index >= steps.length) {
        finishRitual();
        return;
      }
      const step = steps[index];
      if (!step) return;
      dispatchPose(step, index, steps.length);
      nextBtn.hidden = false;
      nextBtn.onclick = () => runStatic(steps, index + 1);
    };

    const runAnimated = (steps: readonly RitualStep[], index: number) => {
      const running = tradition === 'buddhist'
        ? buddhistMachine.status === 'running'
        : taoistMachine.status === 'running';
      if (!running) return;
      if (index >= steps.length) {
        finishRitual();
        return;
      }

      const step = steps[index];
      if (!step) return;
      dispatchPose(step, index, steps.length);
      if (tradition === 'buddhist') buddhistMachine = { ...buddhistMachine, stepIndex: index };
      else taoistMachine = { ...taoistMachine, stepIndex: index };
      timers.push(setTimeout(() => {
        if (tradition === 'buddhist') {
          buddhistMachine = transitionBuddhistRitual(buddhistMachine, { type: 'ADVANCE' });
        } else {
          taoistMachine = transitionTaoistRitual(taoistMachine, { type: 'ADVANCE' });
        }
        runAnimated(steps, index + 1);
      }, step.duration));
    };

    root.querySelector('.jing-reverence-begin')?.addEventListener('click', () => {
      clearTimers();
      progressBar.style.width = '0%';
      progressRoot.setAttribute('aria-valuenow', '0');
      progressRoot.setAttribute('aria-valuetext', '礼敬开始');
      progressText.value = '礼敬开始';
      root.dispatchEvent(new CustomEvent('jing:ritual-start', { bubbles: true }));
      showStage('phases');
      /* 阶段舞台从按钮处向下生长，带进视野中央免得引导文字落在屏外 */
      stages.phases.scrollIntoView({ block: 'center', behavior: reducedMotion() ? 'auto' : 'smooth' });
      if (tradition === 'buddhist') {
        buddhistMachine = transitionBuddhistRitual(buddhistMachine, { type: 'START' });
        const action = buddhistMachine.action;
        if (reducedMotion()) {
          runStatic(getBuddhistReducedSteps(action), 0);
        } else {
          nextBtn.hidden = true;
          circle.classList.add('is-animated');
          scene.classList.add('is-animated');
          runAnimated(getBuddhistRitualSequence(action), 0);
        }
      } else {
        taoistMachine = transitionTaoistRitual(taoistMachine, { type: 'START' });
        const action = taoistMachine.action;
        if (reducedMotion()) {
          runStatic(getTaoistReducedSteps(action), 0);
        } else {
          nextBtn.hidden = true;
          circle.classList.add('is-animated');
          scene.classList.add('is-animated');
          runAnimated(getTaoistRitualSequence(action), 0);
        }
      }
    });

    stopBtn.addEventListener('click', () => {
      clearTimers();
      nextBtn.hidden = true;
      circle.classList.remove('is-animated');
      scene.classList.remove('is-animated');
      buddhistMachine = transitionBuddhistRitual(buddhistMachine, { type: 'STOP' });
      taoistMachine = transitionTaoistRitual(taoistMachine, { type: 'STOP' });
      phaseText.textContent = '';
      progressBar.style.width = '0%';
      progressRoot.setAttribute('aria-valuenow', '0');
      progressRoot.setAttribute('aria-valuetext', '已停止');
      progressText.value = '已停止';
      showStage('start');
      root.dispatchEvent(new CustomEvent('jing:ritual-cancel', { bubbles: true }));
    });

    root.querySelector('.jing-reverence-again')?.addEventListener('click', () => {
      clearTimers();
      buddhistMachine = transitionBuddhistRitual(buddhistMachine, { type: 'RESET' });
      taoistMachine = transitionTaoistRitual(taoistMachine, { type: 'RESET' });
      phaseText.textContent = '';
      progressBar.style.width = '0%';
      progressRoot.setAttribute('aria-valuenow', '0');
      progressRoot.setAttribute('aria-valuetext', '准备开始');
      progressText.value = '准备开始';
      showStage('start');
      root.dispatchEvent(new CustomEvent('jing:ritual-pose', {
        bubbles: true,
        detail: { pose: 'ready', label: '双手安放，呼吸自然；准备好后再开始。' },
      }));
    });
  });
</script>

<style>
  .jing-reverence {
    border-top: 1px solid var(--jing-border);
    margin-top: 2rem;
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .jing-reverence-start { display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .jing-reverence-guide { color: var(--jing-text-dim); font-size: 0.85rem; margin: 0; }

  .jing-reverence-phases {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 0;
  }
  .jing-breath-circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 1px solid var(--jing-accent);
    background: var(--jing-accent-soft);
  }
  .jing-breath-circle.is-animated { animation: jing-breath 6s ease-in-out infinite; }
  @keyframes jing-breath {
    0%, 100% { transform: scale(0.75); opacity: 0.55; }
    50% { transform: scale(1); opacity: 1; }
  }
  .jing-phase-text { font-size: 1.05rem; letter-spacing: 0.25em; margin: 0; min-height: 1.6em; }
  .jing-ritual-progress { width: min(220px, 86%); display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.55rem; }
  .jing-ritual-progress > span { height: 2px; overflow: hidden; background: rgba(184, 147, 74, 0.18); }
  .jing-ritual-progress i { display: block; width: 0; height: 100%; background: var(--jing-accent); transition: width 260ms ease; }
  .jing-ritual-progress output { color: var(--jing-text-dim); font-family: var(--jing-font-ui); font-size: 0.62rem; font-variant-numeric: tabular-nums; }
  .jing-reverence-phase-actions { display: flex; justify-content: center; gap: 0.55rem; }
  .jing-reverence-stop {
    min-height: 38px;
    border-color: rgba(158, 123, 70, 0.28);
    color: var(--jing-text-dim);
    background: rgba(18, 14, 11, 0.72);
  }

