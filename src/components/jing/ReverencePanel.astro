---
/**
 * ReverencePanel — guided, non-gamified reverence flow for one tradition.
 *
 * Flow: read the introductions above -> 合掌礼敬 -> three slow phases ->
 * neutral completion copy. Sacred images live outside this panel and are
 * never controls. With reduced motion, phases advance through explicit
 * static steps instead of timed animation.
 */
import SoundControl from './SoundControl.astro';
import type { Tradition } from '../../data/jing/figures';

interface Props {
  tradition: Tradition;
}

const { tradition } = Astro.props;
const label = tradition === 'buddhist' ? '合掌礼敬' : '拱手礼敬';
---

<div class="jing-reverence" id={`reverence-${tradition}`} data-tradition={tradition}>
  <div class="jing-reverence-start" data-stage="start">
    <p class="jing-reverence-guide">请先静静阅读上方介绍，再决定是否礼敬。</p>
    <button type="button" class="jing-btn jing-reverence-begin">{label}</button>
    <SoundControl />
  </div>

  <div class="jing-reverence-phases" data-stage="phases" hidden>
    <div class="jing-scene" data-scene={tradition} aria-hidden="true">
      {tradition === 'buddhist' ? (
        <svg class="jing-scene-svg" viewBox="0 0 160 120">
          <!-- 香烟 -->
          <g class="jing-smoke" fill="none" stroke="var(--jing-text-dim)" stroke-width="1.2" stroke-linecap="round">
            <path class="jing-smoke-wisp w1" d="M72 74 C 70 62, 76 54, 72 42 C 68 32, 74 24, 71 14" />
            <path class="jing-smoke-wisp w2" d="M84 74 C 86 62, 80 52, 85 40 C 89 30, 83 22, 86 12" />
          </g>
          <!-- 香 -->
          <line x1="72" y1="76" x2="72" y2="92" stroke="var(--jing-vermilion)" stroke-width="1.6" />
          <line x1="84" y1="76" x2="84" y2="92" stroke="var(--jing-vermilion)" stroke-width="1.6" />
          <circle class="jing-ember" cx="72" cy="75" r="1.8" fill="var(--jing-vermilion)" />
          <circle class="jing-ember e2" cx="84" cy="75" r="1.8" fill="var(--jing-vermilion)" />
          <!-- 烛火 -->
          <g class="jing-candle">
            <rect x="37" y="90" width="6" height="16" rx="1.5"
              fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1" />
            <path class="jing-flame f1" d="M40 90 C 37.5 86, 38.5 82, 40 79 C 41.5 82, 42.5 86, 40 90 Z"
              fill="var(--jing-vermilion)" />
          </g>
          <g class="jing-candle">
            <rect x="108" y="90" width="6" height="16" rx="1.5"
              fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1" />
            <path class="jing-flame f2" d="M111 90 C 108.5 86, 109.5 82, 111 79 C 112.5 82, 113.5 86, 111 90 Z"
              fill="var(--jing-vermilion)" />
          </g>
          <!-- 炉 -->
          <path d="M52 92 h52 l-5 14 a24 8 0 0 1 -42 0 z"
            fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1.4" />
          <!-- 莲 -->
          <g class="jing-lotus" stroke="var(--jing-accent)" stroke-width="1.2" fill="var(--jing-accent-soft)">
            <path class="jing-petal p1" d="M128 108 C 120 100, 120 90, 128 84 C 136 90, 136 100, 128 108 Z" />
            <path class="jing-petal p2" d="M128 108 C 118 106, 112 98, 114 90 C 122 92, 128 98, 128 108 Z" />
            <path class="jing-petal p3" d="M128 108 C 138 106, 144 98, 142 90 C 134 92, 128 98, 128 108 Z" />
          </g>
        </svg>
      ) : (
        <svg class="jing-scene-svg" viewBox="0 0 160 120">
          <!-- 云气 -->
          <g class="jing-cloud" fill="none" stroke="var(--jing-text-dim)" stroke-width="1.1" stroke-linecap="round">
            <path d="M8 26 Q 22 18, 36 26 T 64 26" />
            <path d="M96 16 Q 108 10, 120 16 T 152 16" />
          </g>
          <!-- 太极 -->
          <g class="jing-taiji" transform="translate(56 52)">
            <circle r="26" fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1.4" />
            <path d="M0 -26 A 26 26 0 0 1 0 26 A 13 13 0 0 1 0 0 A 13 13 0 0 0 0 -26 Z" fill="var(--jing-accent)" />
            <circle cy="-13" r="3.2" fill="var(--jing-accent)" />
            <circle cy="13" r="3.2" fill="var(--jing-bg-card)" />
          </g>
          <!-- 烛火 -->
          <g class="jing-candle">
            <rect x="33" y="94" width="6" height="16" rx="1.5"
              fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1" />
            <path class="jing-flame f1" d="M36 94 C 33.5 90, 34.5 86, 36 83 C 37.5 86, 38.5 90, 36 94 Z"
              fill="var(--jing-vermilion)" />
          </g>
          <g class="jing-candle">
            <rect x="73" y="94" width="6" height="16" rx="1.5"
              fill="var(--jing-bg-card)" stroke="var(--jing-accent)" stroke-width="1" />
            <path class="jing-flame f2" d="M76 94 C 73.5 90, 74.5 86, 76 83 C 77.5 86, 78.5 90, 76 94 Z"
              fill="var(--jing-vermilion)" />
          </g>
          <!-- 云烟 -->
          <g class="jing-smoke" fill="none" stroke="var(--jing-text-dim)" stroke-width="1.2" stroke-linecap="round">
            <path class="jing-smoke-wisp w1" d="M104 86 C 112 80, 108 70, 116 64 C 124 58, 120 48, 128 42" />
            <path class="jing-smoke-wisp w2" d="M116 92 C 126 88, 124 76, 134 70 C 142 65, 140 56, 148 50" />
          </g>
        </svg>
      )}
    </div>
    <div class="jing-breath-circle" aria-hidden="true"></div>
    <div class="jing-ripples" aria-hidden="true"></div>
    <p class="jing-phase-text" role="status" aria-live="polite"></p>
    <button type="button" class="jing-btn jing-phase-next" hidden>继续</button>
  </div>

  <div class="jing-reverence-done" data-stage="done" hidden>
    <p class="jing-reverence-end">礼敬已毕。愿此刻的安静，伴随你接下来的时光。</p>
    <button type="button" class="jing-btn jing-reverence-again">再礼一次</button>
  </div>
</div>

<script>
  import { AMBIENCE_BY_TRADITION, AMBIENCE_SRC } from '../../data/jing/figures';
  import { loadSettings } from '../../lib/jing/settings';

  document.querySelectorAll<HTMLElement>('.jing-reverence').forEach((root) => {
    const tradition = root.dataset.tradition as 'buddhist' | 'taoist';
    const stages = {
      start: root.querySelector<HTMLElement>('[data-stage="start"]')!,
      phases: root.querySelector<HTMLElement>('[data-stage="phases"]')!,
      done: root.querySelector<HTMLElement>('[data-stage="done"]')!,
    };
    const phaseText = root.querySelector<HTMLElement>('.jing-phase-text')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('.jing-phase-next')!;
    const circle = root.querySelector<HTMLElement>('.jing-breath-circle')!;
    const scene = root.querySelector<HTMLElement>('.jing-scene')!;

    const phases = ['一礼 · 静心', '二礼 · 致敬', '三礼 · 安住'];

    /* ambience created only after explicit opt-in */
    let ambience: HTMLAudioElement[] = [];
    let soundOn = false;
    let soundVol = 0.6;
    const soundControl = root.querySelector('[data-sound-control]');
    soundControl?.addEventListener('jing:sound', (e) => {
      const { enabled, volume } = (e as CustomEvent).detail as { enabled: boolean; volume: number };
      soundOn = enabled;
      soundVol = volume;
      if (enabled && ambience.length === 0) {
        ambience = AMBIENCE_BY_TRADITION[tradition].map((id) => {
          const audio = new Audio(AMBIENCE_SRC[id]);
          audio.loop = true;
          return audio;
        });
      }
      for (const audio of ambience) {
        audio.volume = volume * 0.45;
        if (enabled) void audio.play().catch(() => {});
        else audio.pause();
      }
    });

    /* 每一礼过渡：磬声一记（声音需用户先行开启）+ 涟漪一圈 */
    const PHASE_CHIME: Record<string, string> = {
      buddhist: AMBIENCE_SRC.chime,
      taoist: AMBIENCE_SRC['windchime'],
    };
    let chimeAudio: HTMLAudioElement | null = null;
    const playPhaseChime = () => {
      if (!soundOn) return;
      if (!chimeAudio) chimeAudio = new Audio(PHASE_CHIME[tradition]);
      chimeAudio.volume = Math.min(1, soundVol * 0.7);
      chimeAudio.currentTime = 0;
      void chimeAudio.play().catch(() => {});
    };

    const ripples = root.querySelector<HTMLElement>('.jing-ripples')!;
    const spawnRipple = () => {
      const r = document.createElement('span');
      r.className = 'jing-ripple';
      ripples.appendChild(r);
      setTimeout(() => r.remove(), 2200);
    };

    const showStage = (name: keyof typeof stages) => {
      (Object.keys(stages) as (keyof typeof stages)[]).forEach((k) => {
        stages[k].hidden = k !== name;
      });
    };

    let timers: ReturnType<typeof setTimeout>[] = [];
    const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };

    const reducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || loadSettings(localStorage).settings.motion === 'reduce';

    const runStatic = (index: number) => {
      circle.classList.remove('is-animated');
      scene.classList.remove('is-animated');
      if (index >= phases.length) {
        showStage('done');
        settle();
        return;
      }
      phaseText.textContent = phases[index];
      playPhaseChime();
      nextBtn.hidden = false;
      nextBtn.onclick = () => runStatic(index + 1);
    };

    const settle = () => {
      stages.done.classList.remove('is-settled');
      void stages.done.offsetWidth;
      stages.done.classList.add('is-settled');
    };

    const runAnimated = () => {
      nextBtn.hidden = true;
      circle.classList.add('is-animated');
      scene.classList.add('is-animated');
      phases.forEach((text, i) => {
        timers.push(setTimeout(() => {
          phaseText.textContent = text;
          spawnRipple();
          playPhaseChime();
        }, i * 6000));
      });
      timers.push(setTimeout(() => {
        circle.classList.remove('is-animated');
        scene.classList.remove('is-animated');
        showStage('done');
        settle();
      }, phases.length * 6000));
    };

    root.querySelector('.jing-reverence-begin')?.addEventListener('click', () => {
      showStage('phases');
      if (reducedMotion()) runStatic(0);
      else runAnimated();
    });

    root.querySelector('.jing-reverence-again')?.addEventListener('click', () => {
      clearTimers();
      phaseText.textContent = '';
      showStage('start');
    });
  });
</script>

<style>
  .jing-reverence {
    border-top: 1px solid var(--jing-border);
    margin-top: 2rem;
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .jing-reverence-start { display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .jing-reverence-guide { color: var(--jing-text-dim); font-size: 0.85rem; margin: 0; }

  .jing-reverence-phases {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    padding: 1rem 0;
  }
  .jing-breath-circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 1px solid var(--jing-accent);
    background: var(--jing-accent-soft);
  }
  .jing-breath-circle.is-animated { animation: jing-breath 6s ease-in-out infinite; }
  @keyframes jing-breath {
    0%, 100% { transform: scale(0.75); opacity: 0.55; }
    50% { transform: scale(1); opacity: 1; }
  }
  .jing-phase-text { font-size: 1.05rem; letter-spacing: 0.25em; margin: 0; min-height: 1.6em; }

  .jing-reverence-end { color: var(--jing-text-dim); letter-spacing: 0.1em; }
  .jing-reverence-done { display: flex; flex-direction: column; align-items: center; gap: 1rem; }

  /* ---- 礼敬场景动画（仅动态路径，reduced-motion 静态展示） ---- */
  .jing-scene { display: flex; justify-content: center; }
  .jing-scene-svg { width: 150px; height: auto; }

  .jing-smoke-wisp { stroke-dasharray: 4 5; opacity: 0.5; }
  .jing-scene.is-animated .jing-smoke-wisp { animation: jing-smoke-rise 4.5s linear infinite; }
  .jing-scene.is-animated .jing-smoke-wisp.w2 { animation-delay: 1.8s; }
  @keyframes jing-smoke-rise {
    0% { stroke-dashoffset: 0; opacity: 0.15; }
    35% { opacity: 0.6; }
    100% { stroke-dashoffset: -36; opacity: 0.15; }
  }

  .jing-scene.is-animated .jing-ember { animation: jing-ember-glow 2.2s ease-in-out infinite; }
  .jing-scene.is-animated .jing-ember.e2 { animation-delay: 1.1s; }
  @keyframes jing-ember-glow {
    0%, 100% { opacity: 0.5; r: 1.5; }
    50% { opacity: 1; r: 2.2; }
  }

  .jing-lotus .jing-petal { opacity: 0.55; }
  .jing-scene.is-animated .jing-petal { animation: jing-petal-open 6s ease-in-out infinite; }
  .jing-scene.is-animated .jing-petal.p2 { animation-delay: 2s; }
  .jing-scene.is-animated .jing-petal.p3 { animation-delay: 4s; }
  @keyframes jing-petal-open {
    0%, 100% { opacity: 0.35; transform: scale(0.96); }
    50% { opacity: 0.95; transform: scale(1.02); }
  }
  .jing-lotus .jing-petal { transform-origin: 128px 108px; }

  .jing-scene.is-animated .jing-taiji { animation: jing-taiji-turn 24s linear infinite; transform-origin: 56px 52px; transform-box: view-box; }
  @keyframes jing-taiji-turn {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* 烛火：双焰错频摇曳 */
  .jing-flame { transform-box: fill-box; transform-origin: 50% 100%; opacity: 0.85; }
  .jing-scene.is-animated .jing-flame.f1 { animation: jing-flame-flicker 1.7s ease-in-out infinite alternate; }
  .jing-scene.is-animated .jing-flame.f2 { animation: jing-flame-flicker 1.3s ease-in-out 0.4s infinite alternate; }
  @keyframes jing-flame-flicker {
    0% { transform: scaleY(1) skewX(0deg); opacity: 0.9; }
    40% { transform: scaleY(1.12) skewX(-4deg); opacity: 1; }
    70% { transform: scaleY(0.92) skewX(3deg); opacity: 0.75; }
    100% { transform: scaleY(1.05) skewX(-2deg); opacity: 0.95; }
  }

  /* 道房云气漂移 */
  .jing-cloud { opacity: 0.35; }
  .jing-scene.is-animated .jing-cloud { animation: jing-cloud-drift 26s ease-in-out infinite alternate; }
  @keyframes jing-cloud-drift {
    from { transform: translateX(-4px); opacity: 0.25; }
    50% { opacity: 0.45; }
    to { transform: translateX(6px); opacity: 0.3; }
  }

  /* 一礼一记涟漪 */
  .jing-ripples { position: relative; height: 0; }
  .jing-ripple {
    position: absolute; left: 50%; top: -52px;
    width: 16px; height: 16px; margin-left: -8px;
    border: 1px solid var(--jing-accent); border-radius: 50%;
    opacity: 0.7; pointer-events: none;
    animation: jing-ripple-spread 1.8s ease-out forwards;
  }
  @keyframes jing-ripple-spread {
    from { transform: scale(1); opacity: 0.65; }
    to { transform: scale(6.5); opacity: 0; }
  }

  /* 三礼收场：缓缓亮起 */
  .jing-reverence-done.is-settled { animation: jing-settle 2s ease both; }
  @keyframes jing-settle {
    from { opacity: 0; filter: brightness(1.5); }
    to { opacity: 1; filter: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .jing-scene.is-animated .jing-smoke-wisp,
    .jing-scene.is-animated .jing-ember,
    .jing-scene.is-animated .jing-petal,
    .jing-scene.is-animated .jing-taiji,
    .jing-scene.is-animated .jing-flame,
    .jing-scene.is-animated .jing-cloud,
    .jing-ripple,
    .jing-reverence-done.is-settled { animation: none; }
    .jing-ripple { opacity: 0; }
  }
</style>
