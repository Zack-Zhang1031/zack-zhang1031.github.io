---
/**
 * BaziForm — local four-pillars study tool.
 *
 * All calculation runs in the browser; nothing is stored or sent.
 * The result region is ordered 输入摘要 → 盘面 → 推演 → 简释 → 提醒,
 * each collapsible. A copy button produces a plain-text summary that
 * can be pasted into the encrypted notebook.
 */
import { CITIES } from '../../data/jing/cities';
---

<form id="bazi-form" class="jing-bazi" autocomplete="off" novalidate>
  <fieldset class="jing-fieldset">
    <legend>出生时刻</legend>
    <div class="jing-bazi-grid">
      <label>年
        <input id="bazi-year" name="year" type="number" min="1900" max="2100" step="1" placeholder="年" required />
      </label>
      <label>月
        <input id="bazi-month" name="month" type="number" min="1" max="12" step="1" placeholder="月" required />
      </label>
      <label>日
        <input id="bazi-day" name="day" type="number" min="1" max="31" step="1" placeholder="日" required />
      </label>
      <label>时
        <input id="bazi-hour" name="hour" type="number" min="0" max="23" step="1" placeholder="时" required />
      </label>
      <label>分
        <input id="bazi-minute" name="minute" type="number" min="0" max="59" step="1" placeholder="分" required />
      </label>
    </div>
    <p class="jing-bazi-hint">公历（阳历）时刻，支持 1900—2100 年。示例：1986 年 5 月 29 日 00:00（示例不会自动填入）。</p>
  </fieldset>

  <fieldset class="jing-fieldset">
    <legend>时间规则</legend>
    <div class="jing-bazi-radios" role="radiogroup" aria-label="时刻制度">
      <label><input type="radio" name="timeMode" value="legal" checked /> 法定时（北京时间）</label>
      <label><input type="radio" name="timeMode" value="true-solar" /> 真太阳时（按经度修正）</label>
    </div>
    <div class="jing-bazi-place" id="bazi-place" hidden>
      <label>城市
        <select id="bazi-city">
          {CITIES.map((city) => (
            <option value={city.longitude}>{city.name}（{city.longitude}°E）</option>
          ))}
          <option value="manual">手动输入经度</option>
        </select>
      </label>
      <label>东经（度）
        <input id="bazi-longitude" type="number" min="70" max="140" step="0.01" value={CITIES[0].longitude} />
      </label>
    </div>
    <div class="jing-bazi-radios" role="radiogroup" aria-label="晚子时规则">
      <span class="jing-bazi-radio-title">晚子时（23:00—24:00）：</span>
      <label><input type="radio" name="lateZi" value="next-day" checked /> 归次日（23 点换日）</label>
      <label><input type="radio" name="lateZi" value="same-day" /> 不换日（0 点换日）</label>
    </div>
  </fieldset>

  <div class="jing-bazi-actions">
    <button type="submit" id="bazi-submit" class="jing-btn jing-btn-primary">排盘</button>
    <button type="button" id="bazi-now" class="jing-btn">填入此刻</button>
    <button type="reset" class="jing-btn">清空</button>
    <span id="bazi-status" class="jing-calc-status" role="status" aria-live="polite">填写公历时刻后排盘</span>
  </div>

  <p id="bazi-error" class="jing-bazi-error" role="alert" hidden></p>
</form>

<section id="bazi-result" class="jing-bazi-result" hidden aria-live="polite" tabindex="-1">
  <header class="jing-study-result-head">
    <div><p class="jing-eyebrow">本地推演 · bazi-1.0.0</p><h2 class="jing-calc-result-title">八字排盘结果</h2></div>
    <button type="button" id="bazi-edit" class="jing-btn">重新编辑</button>
  </header>
  <details id="bazi-sec-summary" open>
    <summary>输入摘要</summary>
    <p id="bazi-summary-text"></p>
    <button type="button" id="bazi-copy" class="jing-btn">复制摘要（可粘贴到笔记）</button>
    <span id="bazi-copy-state" class="jing-bazi-copy-state" role="status"></span>
  </details>

  <details id="bazi-sec-pillars" open>
    <summary>盘面</summary>
    <div id="bazi-pillars" class="jing-bazi-pillars"></div>
    <p id="bazi-elements" class="jing-bazi-elements"></p>
    <div id="bazi-element-bars" class="jing-bazi-element-bars" aria-label="五行分布比例"></div>
    <div class="jing-bazi-year-index">
      <h3>近年流年索引</h3>
      <p>按立春换年惯例列干支索引；此处不推算大运起运，以免在缺少性别与起运规则时给出伪精确结果。</p>
      <div id="bazi-year-timeline" class="jing-bazi-year-timeline"></div>
    </div>
  </details>

  <details id="bazi-sec-derivation">
    <summary>推演</summary>
    <ol id="bazi-derivation" class="jing-bazi-derivation"></ol>
  </details>

  <details id="bazi-sec-reading">
    <summary>简释</summary>
    <div id="bazi-interpret" class="jing-bazi-interpret"></div>
  </details>

  <details id="bazi-sec-reminders">
    <summary>提醒</summary>
    <ul id="bazi-reminders" class="jing-bazi-reminders"></ul>
  </details>
</section>

<script>
  import { calculateBazi } from '../../lib/jing/bazi/calculate';
  import { interpretBazi } from '../../lib/jing/bazi/interpret';

  const form = document.getElementById('bazi-form') as HTMLFormElement | null;
  if (form) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const result = $('bazi-result');
    const errorEl = $('bazi-error');
    const statusEl = $('bazi-status');
    const submitBtn = $('bazi-submit') as HTMLButtonElement;
    const place = $('bazi-place');
    const city = $('bazi-city') as HTMLSelectElement;
    const longitude = $('bazi-longitude') as HTMLInputElement;
    const timeFieldIds = ['bazi-year', 'bazi-month', 'bazi-day', 'bazi-hour', 'bazi-minute'] as const;

    const showError = (message: string) => {
      errorEl.textContent = message;
      errorEl.hidden = false;
      result.hidden = true;
      statusEl.textContent = '排盘未完成，请检查输入。';
      statusEl.classList.add('is-error');
    };
    const clearError = () => {
      errorEl.textContent = '';
      errorEl.hidden = true;
      statusEl.classList.remove('is-error');
    };

    form.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === 'timeMode') {
        place.hidden = target.value !== 'true-solar';
      }
    });
    city.addEventListener('change', () => {
      if (city.value !== 'manual') longitude.value = city.value;
    });
    longitude.addEventListener('input', () => {
      city.value = 'manual';
    });

    $('bazi-now').addEventListener('click', () => {
      const now = new Date();
      const values = [now.getFullYear(), now.getMonth() + 1, now.getDate(), now.getHours(), now.getMinutes()];
      timeFieldIds.forEach((id, index) => { ($<HTMLInputElement>(id)).value = String(values[index]); });
      clearError();
      statusEl.textContent = '已填入本机此刻 · 可按需要调整后排盘';
    });

    const PILLAR_NAMES: Record<string, string> = { year: '年柱', month: '月柱', day: '日柱', hour: '时柱' };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearError();
      submitBtn.disabled = true;
      submitBtn.textContent = '排盘中…';
      statusEl.textContent = '正在按所选时间规则推演四柱…';
      try {
        const missing = timeFieldIds.find((id) => !$<HTMLInputElement>(id).value.trim());
        if (missing) {
          $<HTMLInputElement>(missing).focus();
          throw new Error('请完整填写年、月、日、时、分后再排盘。');
        }
        const timeMode = (form.querySelector('input[name="timeMode"]:checked') as HTMLInputElement).value as 'legal' | 'true-solar';
        const lateZi = (form.querySelector('input[name="lateZi"]:checked') as HTMLInputElement).value as 'same-day' | 'next-day';
        const input = {
          year: Number(($('bazi-year') as HTMLInputElement).value),
          month: Number(($('bazi-month') as HTMLInputElement).value),
          day: Number(($('bazi-day') as HTMLInputElement).value),
          hour: Number(($('bazi-hour') as HTMLInputElement).value),
          minute: Number(($('bazi-minute') as HTMLInputElement).value),
          timeMode,
          lateZi,
          ...(timeMode === 'true-solar' ? { longitude: Number(longitude.value) } : {}),
        };

        const envelope = calculateBazi(input);
        const reading = interpretBazi(envelope);
        const { pillars } = envelope.output;

        const p = (n: number) => String(n).padStart(2, '0');
        const modeLabel = timeMode === 'legal' ? '法定时' : `真太阳时（${Number(longitude.value).toFixed(2)}°E）`;
        const ziLabel = lateZi === 'next-day' ? '晚子时归次日' : '晚子时不换日';
        $('bazi-summary-text').textContent =
          `${input.year}-${p(input.month)}-${p(input.day)} ${p(input.hour)}:${p(input.minute)} · ${modeLabel} · ${ziLabel}`
          + ` → ${pillars.year} / ${pillars.month} / ${pillars.day} / ${pillars.hour}`
          + `（日主${envelope.output.dayMaster.stem}${envelope.output.dayMaster.element}）`;

        $('bazi-pillars').innerHTML = (['year', 'month', 'day', 'hour'] as const).map((key, i) => {
          const god = key === 'day' ? '日主' : envelope.output.tenGods[key];
          const detail = envelope.output.pillarDetails[key];
          const hidden = detail.hiddenStems.map((item) => `${item.stem}<small>${item.tenGod}</small>`).join('');
          return `<article class="jing-bazi-pillar" style="animation-delay:${i * 90}ms">`
            + `<header><span class="jing-bazi-pillar-name">${PILLAR_NAMES[key]}</span><span class="jing-bazi-pillar-god">${god}</span></header>`
            + `<div class="jing-bazi-ganzhi"><strong>${detail.stem}</strong><strong>${detail.branch}</strong></div>`
            + `<dl><div><dt>藏干</dt><dd>${hidden}</dd></div><div><dt>纳音</dt><dd>${detail.naYin}</dd></div></dl></article>`;
        }).join('');
        $('bazi-elements').textContent = '五行分布：'
          + Object.entries(envelope.output.elements).map(([k, v]) => `${k}${v}`).join('　');
        const maxElement = Math.max(...Object.values(envelope.output.elements), 1);
        $('bazi-element-bars').innerHTML = Object.entries(envelope.output.elements)
          .map(([name, value], index) => `<div class="jing-bazi-element-bar" style="--bar-delay:${index * 90}ms">`
            + `<span>${name}</span><i><b style="--bar-size:${(value / maxElement) * 100}%"></b></i><em>${value}</em></div>`)
          .join('');

        const stems = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸'];
        const branches = ['子', '丑', '寅', '卯', '辰', '巳', '午', '未', '申', '酉', '戌', '亥'];
        const currentYear = new Date().getFullYear();
        const yearGanzhi = (year: number) => {
          const offset = ((year - 1984) % 60 + 60) % 60;
          return `${stems[offset % 10]}${branches[offset % 12]}`;
        };
        $('bazi-year-timeline').innerHTML = Array.from({ length: 9 }, (_, index) => currentYear - 4 + index)
          .map((year) => `<span${year === currentYear ? ' class="is-current"' : ''}><b>${yearGanzhi(year)}</b><i>${year}</i></span>`)
          .join('');

        $('bazi-derivation').innerHTML = envelope.derivation
          .map((step) => `<li><strong>${step.label}</strong><span>${step.rule}</span><em>${step.value}</em></li>`)
          .join('');

        $('bazi-interpret').innerHTML = [
          `<p>${reading.dayMaster}</p>`,
          ...reading.elementBalance.map((line) => `<p>${line}</p>`),
          ...reading.tenGods.map((line) => `<p>${line}</p>`),
        ].join('');

        $('bazi-reminders').innerHTML = reading.reminders.map((line) => `<li>${line}</li>`).join('');

        $('bazi-copy-state').textContent = '';
        result.hidden = false;
        statusEl.textContent = `排盘完成 · ${pillars.year}、${pillars.month}、${pillars.day}、${pillars.hour}`;
        result.focus({ preventScroll: true });
        result.scrollIntoView({
          block: 'start',
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      } catch (error) {
        showError(error instanceof Error ? error.message : '输入无法解析，请检查后重试。');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '重新排盘';
      }
    });

    form.addEventListener('reset', () => {
      clearError();
      result.hidden = true;
      place.hidden = true;
      city.selectedIndex = 0;
      longitude.value = city.value;
      submitBtn.textContent = '排盘';
      statusEl.textContent = '填写公历时刻后排盘';
      statusEl.classList.remove('is-error');
    });

    $('bazi-copy').addEventListener('click', async () => {
      const text = $('bazi-summary-text').textContent ?? '';
      const state = $('bazi-copy-state');
      try {
        await navigator.clipboard.writeText(text);
        state.innerHTML = '已复制。<a class="jing-note-link" href="/jing/notes/">去笔记房粘贴 →</a>';
      } catch {
        state.textContent = '复制失败，请手动选择文本复制。';
      }
    });

    // nothing persists: a fresh page load always starts empty
    window.addEventListener('pageshow', () => {
      form.reset();
      clearError();
      result.hidden = true;
      submitBtn.textContent = '排盘';
      statusEl.textContent = '填写公历时刻后排盘';
    });

    $('bazi-edit').addEventListener('click', () => {
      form.scrollIntoView({ block: 'start', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      ($('bazi-year') as HTMLInputElement).focus({ preventScroll: true });
    });
  }
</script>

<style>
  .jing-bazi { display: flex; flex-direction: column; gap: 1.25rem; }

  .jing-fieldset {
    border: 1px solid var(--jing-border);
    border-radius: var(--jing-radius);
    padding: 1rem 1.1rem 1.2rem;
    background: var(--jing-bg-raised);
  }
  .jing-fieldset legend {
    font-size: 0.85rem; letter-spacing: 0.25em; color: var(--jing-text-dim);
    padding: 0 0.5em;
  }

  .jing-bazi-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.6rem; }
  .jing-bazi-grid label, .jing-bazi-place label {
    display: flex; flex-direction: column; gap: 0.3rem;
    font-family: var(--jing-font-ui); font-size: 0.75rem; color: var(--jing-text-dim);
  }
  .jing-bazi input, .jing-bazi select {
    font-family: var(--jing-font-ui); font-size: 0.95rem;
    color: var(--jing-text); background: var(--jing-bg-card);
    border: 1px solid var(--jing-border); border-radius: 6px;
    padding: 0.45rem 0.5rem; width: 100%; box-sizing: border-box;
  }
  .jing-bazi input:focus-visible, .jing-bazi select:focus-visible {
    outline: 2px solid var(--jing-accent); outline-offset: 1px;
  }
  .jing-bazi-hint { margin: 0.6rem 0 0; font-family: var(--jing-font-ui); font-size: 0.72rem; color: var(--jing-text-dim); }

  .jing-bazi-radios {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; align-items: center;
    font-family: var(--jing-font-ui); font-size: 0.85rem;
  }
  .jing-bazi-radios + .jing-bazi-radios { margin-top: 0.8rem; }
  .jing-bazi-radios label { display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; }
  .jing-bazi-radios input { width: auto; }
  .jing-bazi-radio-title { color: var(--jing-text-dim); font-size: 0.78rem; }

  .jing-bazi-place { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-top: 0.8rem; }
  .jing-bazi-place[hidden], .jing-bazi-result[hidden] { display: none; }

  .jing-bazi-actions { display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap; }
  .jing-calc-status { font-family: var(--jing-font-ui); font-size: 0.74rem; color: var(--jing-accent); }
  .jing-calc-status.is-error { color: var(--jing-vermilion); }
  .jing-calc-result-title { margin: 0; color: var(--jing-accent); font-size: 1rem; font-weight: 500; letter-spacing: 0.18em; }
  .jing-study-result-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .jing-study-result-head .jing-eyebrow { margin-bottom: 0.35rem; }
  .jing-btn-primary { border-color: var(--jing-accent); color: var(--jing-accent); }

  .jing-bazi-error {
    margin: 0; padding: 0.7rem 0.9rem;
    border: 1px solid var(--jing-vermilion); border-radius: 6px;
    color: var(--jing-vermilion); font-family: var(--jing-font-ui); font-size: 0.85rem;
  }

  .jing-bazi-result { display: flex; flex-direction: column; gap: 0.8rem; margin-top: 1.75rem; }
  .jing-bazi-result details {
    border: 1px solid var(--jing-border); border-radius: var(--jing-radius);
    background: var(--jing-bg-raised); padding: 0.6rem 1rem 0.9rem;
  }
  .jing-bazi-result summary {
    cursor: pointer; letter-spacing: 0.25em; color: var(--jing-accent);
    padding: 0.4rem 0; font-size: 0.95rem;
  }
  .jing-bazi-result p { margin: 0.5rem 0; }

  .jing-bazi-pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; margin: 0.5rem 0; }
  .jing-bazi-pillar {
    display: flex; flex-direction: column; align-items: stretch; gap: 0.55rem;
    border: 1px solid var(--jing-border); border-radius: 8px; padding: 0.7rem 0.3rem;
    background: var(--jing-bg-card);
    animation: jing-pillar-in 0.55s ease both;
  }
  @keyframes jing-pillar-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  .jing-bazi-pillar header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .jing-bazi-ganzhi { display: grid; gap: 0.2rem; place-items: center; padding: 0.35rem 0; }
  .jing-bazi-pillar strong { font-size: 1.55rem; letter-spacing: 0.15em; color: var(--jing-text); }
  .jing-bazi-pillar dl { margin: 0; display: grid; gap: 0.35rem; }
  .jing-bazi-pillar dl div { display: grid; grid-template-columns: 2.4rem 1fr; gap: 0.35rem; align-items: baseline; }
  .jing-bazi-pillar dt { font-family: var(--jing-font-ui); font-size: 0.64rem; color: var(--jing-text-dim); }
  .jing-bazi-pillar dd { margin: 0; font-size: 0.78rem; color: var(--jing-text); }
  .jing-bazi-pillar dd small { margin: 0 0.5em 0 0.15em; color: var(--jing-vermilion); font-family: var(--jing-font-ui); font-size: 0.58rem; }
  .jing-bazi-pillar-name, .jing-bazi-pillar-god {
    font-family: var(--jing-font-ui); font-size: 0.7rem; color: var(--jing-text-dim);
  }
  .jing-bazi-pillar-god { color: var(--jing-accent); }
  .jing-bazi-elements { font-size: 0.9rem; color: var(--jing-text-dim); }

  .jing-bazi-derivation { margin: 0.5rem 0 0; padding-left: 1.4rem; }
  .jing-bazi-derivation li { margin: 0.4rem 0; font-size: 0.88rem; }
  .jing-bazi-derivation strong { margin-right: 0.6em; }
  .jing-bazi-derivation span { color: var(--jing-text-dim); margin-right: 0.6em; font-size: 0.8rem; }
  .jing-bazi-derivation em { font-style: normal; color: var(--jing-accent); }

  .jing-bazi-reminders { margin: 0.5rem 0 0; padding-left: 1.3rem; font-size: 0.85rem; color: var(--jing-text-dim); }
  .jing-bazi-copy-state { font-family: var(--jing-font-ui); font-size: 0.75rem; color: var(--jing-text-dim); margin-left: 0.7rem; }

  @media (max-width: 560px) {
    .jing-bazi-grid { grid-template-columns: repeat(3, 1fr); }
    .jing-bazi-place { grid-template-columns: 1fr; }
    .jing-bazi-pillars { grid-template-columns: repeat(2, 1fr); }
  }
</style>
