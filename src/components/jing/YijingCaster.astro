---
/**
 * YijingCaster — five casting methods over one canonical line model.
 * 铜钱 / 蓍草 / 数字 / 时间 / 手动. Results are rendered only; nothing
 * persists and nothing leaves the browser.
 */
import SoundControl from './SoundControl.astro';
---

<div class="jing-yijing" id="jing-yijing-app">
  <div class="jing-yj-topbar">
    <div class="jing-yj-tabs" role="tablist" aria-label="起卦方式">
      <button type="button" role="tab" id="yj-tab-coins" aria-controls="yj-panel-coins" aria-selected="true">铜钱</button>
      <button type="button" role="tab" id="yj-tab-yarrow" aria-controls="yj-panel-yarrow" aria-selected="false">蓍草</button>
      <button type="button" role="tab" id="yj-tab-numbers" aria-controls="yj-panel-numbers" aria-selected="false">数字</button>
      <button type="button" role="tab" id="yj-tab-time" aria-controls="yj-panel-time" aria-selected="false">时间</button>
      <button type="button" role="tab" id="yj-tab-manual" aria-controls="yj-panel-manual" aria-selected="false">手动</button>
    </div>
    <SoundControl layers={['rain', 'insects', 'tea']} />
  </div>
  <p id="yj-method-status" class="jing-yj-method-status" role="status" aria-live="polite">铜钱法 · 连掷六次，自初爻至上爻。</p>

  <section id="yj-panel-coins" role="tabpanel" aria-labelledby="yj-tab-coins">
    <p class="jing-yj-hint">三枚铜钱一掷：字三背二，合计得六、七、八、九。连掷六次，自初爻至上爻。</p>
    <div class="jing-yj-actions">
      <button type="button" id="yj-coins-throw" class="jing-btn jing-btn-primary">掷一次（第 <span id="yj-coins-next">1</span> 掷）</button>
      <button type="button" id="yj-coins-reset" class="jing-btn">重来</button>
    </div>
    <div class="jing-yj-casting-workbench">
      <div class="jing-yj-coins" id="yj-coins-stage" role="img" aria-label="三枚铜钱，尚未投掷">
        {[0, 1, 2].map((index) => (
          <span class="jing-yj-coin" data-face="front" aria-label={`第 ${index + 1} 枚，字面`}>
            <span class="jing-yj-coin-inner">
              <i class="jing-yj-coin-face jing-yj-coin-front"><b>字</b><u aria-hidden="true"></u><small>字面</small></i>
              <i class="jing-yj-coin-face jing-yj-coin-back"><b>背</b><u aria-hidden="true"></u><small>背面</small></i>
            </span>
          </span>
        ))}
      </div>
      <aside class="jing-yj-progress-card" aria-label="六爻生成进度">
        <p>六爻渐成 <span id="yj-coins-count">0 / 6</span></p>
        <div id="yj-coins-progress" class="jing-yj-progress-lines"></div>
      </aside>
    </div>
    <ol id="yj-coins-log" class="jing-yj-log" aria-live="polite"></ol>
  </section>

  <section id="yj-panel-yarrow" role="tabpanel" aria-labelledby="yj-tab-yarrow" hidden>
    <p class="jing-yj-hint">大衍之数四十九：分二、挂一、揲四、归奇，三变得一爻，六变成卦。过程逐变列出。</p>
    <div class="jing-yj-actions">
      <button type="button" id="yj-yarrow-cast" class="jing-btn jing-btn-primary">演卦</button>
      <button type="button" id="yj-yarrow-reset" class="jing-btn">重来</button>
    </div>
    <ol id="yj-yarrow-log" class="jing-yj-log" aria-live="polite"></ol>
  </section>

  <section id="yj-panel-numbers" role="tabpanel" aria-labelledby="yj-tab-numbers" hidden>
    <p class="jing-yj-hint">梅花易数简式：上卦 = 数一 mod 8，下卦 = 数二 mod 8，动爻 = 数三 mod 6（先天卦数：乾一兑二离三震四巽五坎六艮七坤八）。</p>
    <div class="jing-yj-inputs">
      <label>数一<input id="yj-num-1" type="number" step="1" placeholder="3" /></label>
      <label>数二<input id="yj-num-2" type="number" step="1" placeholder="5" /></label>
      <label>数三<input id="yj-num-3" type="number" step="1" placeholder="8" /></label>
    </div>
    <div class="jing-yj-actions">
      <button type="button" id="yj-numbers-cast" class="jing-btn jing-btn-primary">起卦</button>
    </div>
    <p id="yj-numbers-formula" class="jing-yj-formula" aria-live="polite"></p>
  </section>

  <section id="yj-panel-time" role="tabpanel" aria-labelledby="yj-tab-time" hidden>
    <p class="jing-yj-hint">梅花易数简式：上卦 =（年+月+日）mod 8，下卦 =（年+月+日+时）mod 8，动爻 =（年+月+日+时）mod 6。时为 0—23。</p>
    <div class="jing-yj-inputs jing-yj-inputs-4">
      <label>年<input id="yj-time-y" type="number" min="1900" max="2100" step="1" placeholder="2024" /></label>
      <label>月<input id="yj-time-m" type="number" min="1" max="12" step="1" placeholder="2" /></label>
      <label>日<input id="yj-time-d" type="number" min="1" max="31" step="1" placeholder="4" /></label>
      <label>时<input id="yj-time-h" type="number" min="0" max="23" step="1" placeholder="12" /></label>
    </div>
    <div class="jing-yj-actions">
      <button type="button" id="yj-time-cast" class="jing-btn jing-btn-primary">起卦</button>
      <button type="button" id="yj-time-now" class="jing-btn">填入此刻</button>
    </div>
    <p id="yj-time-formula" class="jing-yj-formula" aria-live="polite"></p>
  </section>

  <section id="yj-panel-manual" role="tabpanel" aria-labelledby="yj-tab-manual" hidden>
    <p class="jing-yj-hint">直接录入六爻：6 老阴、7 少阳、8 少阴、9 老阳。自下而上填写。</p>
    <div class="jing-yj-inputs jing-yj-inputs-6">
      <label>初爻<input id="yj-man-1" type="number" step="1" placeholder="7" /></label>
      <label>二爻<input id="yj-man-2" type="number" step="1" placeholder="8" /></label>
      <label>三爻<input id="yj-man-3" type="number" step="1" placeholder="9" /></label>
      <label>四爻<input id="yj-man-4" type="number" step="1" placeholder="7" /></label>
      <label>五爻<input id="yj-man-5" type="number" step="1" placeholder="6" /></label>
      <label>上爻<input id="yj-man-6" type="number" step="1" placeholder="8" /></label>
    </div>
    <p id="yj-manual-error" class="jing-yj-error" role="alert" hidden></p>
    <div class="jing-yj-actions">
      <button type="button" id="yj-manual-cast" class="jing-btn jing-btn-primary">起卦</button>
    </div>
  </section>

  <section id="yj-result" class="jing-yj-result" hidden aria-live="polite" tabindex="-1">
    <div class="jing-yj-hexagram-compare">
      <article>
        <span class="jing-yj-compare-label">本卦</span>
        <p id="yj-primary" class="jing-yj-primary"></p>
        <div id="yj-diagram" class="jing-yj-diagram" aria-label="本卦卦画（自上而下）"></div>
      </article>
      <span class="jing-yj-change-arrow" aria-hidden="true">→</span>
      <article>
        <span class="jing-yj-compare-label">之卦</span>
        <p id="yj-changed" class="jing-yj-primary">—</p>
        <div id="yj-changed-diagram" class="jing-yj-diagram jing-yj-changed-diagram" aria-label="之卦卦画（自上而下）"></div>
      </article>
    </div>
    <div class="jing-yj-reading">
      <div class="jing-yj-names">
        <p id="yj-moving" class="jing-yj-moving"></p>
        <dl class="jing-yj-derived">
          <div><dt>互卦</dt><dd id="yj-mutual">—</dd></div>
          <div><dt>错卦</dt><dd id="yj-opposite">—</dd></div>
          <div><dt>综卦</dt><dd id="yj-reversed">—</dd></div>
        </dl>
      </div>
    </div>
    <p class="jing-yj-hint">卦象只列名相与结构，不作吉凶断言。结果不保存，刷新即清。卦序核对：<a href="https://ctext.org/book-of-changes/zh" target="_blank" rel="noreferrer">《周易》原典</a>；本站暂不转录卦爻辞。</p>
    <div class="jing-yj-note-actions">
      <button type="button" id="yj-note-copy" class="jing-btn">复制卦录（可粘贴到笔记）</button>
      <span id="yj-note-state" class="jing-yj-note-state" role="status"></span>
    </div>
  </section>
</div>

<script>
  import { castManual, castNumbers, castTime, castYarrow, throwCoins } from '../../lib/jing/yijing/cast';
  import { changedLines, deriveAll } from '../../lib/jing/yijing/derive';
  import { YAO_LABEL, isMoving, isYang, type YaoValue } from '../../lib/jing/yijing/lines';
  import { cryptoRandomSource } from '../../lib/jing/random';
  import { loadSettings } from '../../lib/jing/settings';
  import { FX_SRC, LAYER_SRC, playFx, registerAmbience, setAmbienceVolume } from '../../lib/jing/sound-fx';

  const app = document.getElementById('jing-yijing-app');
  if (app) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const result = $('yj-result');
    const methodStatus = $('yj-method-status');
    const reducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || loadSettings(localStorage).settings.motion === 'reduce';
    const setMethodStatus = (message: string, error = false) => {
      methodStatus.textContent = message;
      methodStatus.classList.toggle('is-error', error);
    };

    /* ---- 声音：铜钱动作音 + 可选氛围层（需用户开启） ---- */
    let soundOn = false;
    let soundVol = 0.6;
    let layerAudio: HTMLAudioElement | null = null;
    let layerId: string | null = null;

    app.querySelector('[data-sound-control]')?.addEventListener('jing:sound', (e) => {
      const { enabled, volume, layer } = (e as CustomEvent).detail as
        { enabled: boolean; volume: number; layer: string | null };
      soundOn = enabled;
      soundVol = volume;
      if (!enabled || !layer) {
        layerAudio?.pause();
        return;
      }
      if (!layerAudio || layerId !== layer) {
        layerAudio?.pause();
        layerAudio = new Audio(LAYER_SRC[layer]);
        layerAudio.loop = true;
        layerId = layer;
        registerAmbience(layerAudio);
      }
      setAmbienceVolume(layerAudio, volume * 0.4);
      void layerAudio.play().catch(() => {});
    });

    const fx = (src: string, scale = 1) => {
      if (soundOn) playFx(src, soundVol * scale);
    };

    /* ---- tabs ---- */
    const tabs = Array.from(app.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const TAB_GUIDE: Record<string, string> = {
      'yj-tab-coins': '铜钱法 · 连掷六次，自初爻至上爻。',
      'yj-tab-yarrow': '蓍草法 · 代码完整演算每爻三变，并列出归奇过程。',
      'yj-tab-numbers': '数字法 · 输入三个整数，显示取余公式后成卦。',
      'yj-tab-time': '时间法 · 可手填时刻，也可一键填入此刻。',
      'yj-tab-manual': '手动法 · 依次填写 6、7、8、9，自初爻至上爻。',
    };
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        for (const t of tabs) {
          const selected = t === tab;
          t.setAttribute('aria-selected', String(selected));
          const panel = document.getElementById(t.getAttribute('aria-controls')!);
          if (panel) (panel as HTMLElement).hidden = !selected;
        }
        setMethodStatus(TAB_GUIDE[tab.id] ?? '选择一种起卦方式。');
      });
    }

    /* ---- shared rendering ---- */
    const renderResult = (values: YaoValue[]) => {
      const views = deriveAll(values);
      const renderDiagram = (diagramValues: YaoValue[], lineClass: string) => [...diagramValues].reverse().map((value, i) => {
        const pos = 6 - i;
        const yang = isYang(value);
        const mark = isMoving(value) ? `<span class="jing-yj-mark">${value === 9 ? '○' : '×'}</span>` : '<span class="jing-yj-mark"></span>';
        return `<div class="${lineClass}" data-pos="${pos}" style="animation-delay:${(pos - 1) * 90}ms">`
          + `<span class="jing-yj-bar ${yang ? 'is-yang' : 'is-yin'}">${yang ? '' : '<i></i><i></i>'}</span>`
          + mark
          + `<span class="jing-yj-line-label">${YAO_LABEL[value]}</span></div>`;
      }).join('');
      $('yj-diagram').innerHTML = renderDiagram(values, 'jing-yj-line');
      $('yj-changed-diagram').innerHTML = renderDiagram(changedLines(values), 'jing-yj-change-line');
      $('yj-primary').textContent = `${views.primary.name}（第 ${views.primary.seq} 卦）`;
      $('yj-moving').textContent = views.moving.length > 0
        ? `动爻：${views.moving.join('、')} 爻`
        : '六爻安静，无动爻';
      $('yj-changed').textContent = views.changed ? `${views.changed.name}（第 ${views.changed.seq} 卦）` : '无变卦';
      $('yj-mutual').textContent = `${views.mutual.name}（第 ${views.mutual.seq} 卦）`;
      $('yj-opposite').textContent = `${views.opposite.name}（第 ${views.opposite.seq} 卦）`;
      $('yj-reversed').textContent = `${views.reversed.name}（第 ${views.reversed.seq} 卦）`;
      result.hidden = false;
      setMethodStatus(`成卦完成 · ${views.primary.name}${views.moving.length ? `，动爻 ${views.moving.join('、')}` : '，六爻安静'}`);
      result.focus({ preventScroll: true });
      result.scrollIntoView({ block: 'start', behavior: reducedMotion() ? 'auto' : 'smooth' });
    };

    /* ---- coins ---- */
    let coinValues: YaoValue[] = [];
    let coinTossing = false;
    let coinTimer: ReturnType<typeof setTimeout> | null = null;
    const coinsLog = $('yj-coins-log');
    const renderCoins = () => {
      $('yj-coins-next').textContent = String(Math.min(coinValues.length + 1, 6));
      ($('yj-coins-throw') as HTMLButtonElement).disabled = coinValues.length >= 6 || coinTossing;
      coinsLog.innerHTML = coinValues.map((value, i) =>
        `<li>第 ${i + 1} 掷得 ${YAO_LABEL[value]}（${value}）</li>`).join('');
      $('yj-coins-count').textContent = `${coinValues.length} / 6`;
      $('yj-coins-progress').innerHTML = Array.from({ length: 6 }, (_, row) => {
        const index = 5 - row;
        const value = coinValues[index];
        if (value === undefined) return `<div class="jing-yj-progress-line is-empty"><span>${index + 1}</span><i></i></div>`;
        const yang = isYang(value);
        return `<div class="jing-yj-progress-line is-filled"><span>${index + 1}</span>`
          + `<i class="${yang ? 'is-yang' : 'is-yin'}">${yang ? '' : '<b></b><b></b>'}</i><em>${YAO_LABEL[value]}</em></div>`;
      }).join('');
      if (coinValues.length === 6) renderResult(coinValues);
    };
    $('yj-coins-throw').addEventListener('click', () => {
      if (coinValues.length >= 6 || coinTossing) return;
      const cast = throwCoins(cryptoRandomSource);
      const stage = $('yj-coins-stage');
      const coins = Array.from(stage.querySelectorAll<HTMLElement>('.jing-yj-coin'));
      const throwIndex = coinValues.length + 1;
      coinTossing = true;
      setMethodStatus(`第 ${throwIndex} 掷 · 铜钱翻转中…`);
      stage.classList.remove('is-tossing');
      void stage.offsetWidth;
      if (!reducedMotion()) stage.classList.add('is-tossing');
      coins.forEach((coin, index) => {
        const front = Boolean(cast.faces[index]);
        coin.dataset.face = front ? 'front' : 'back';
        coin.setAttribute('aria-label', `第 ${index + 1} 枚，${front ? '字面' : '背面'}`);
      });
      stage.setAttribute('aria-label', cast.faces.map((front) => front ? '字面' : '背面').join('、'));
      fx(FX_SRC.coinsToss, 0.85);
      const finish = () => {
        coinValues.push(cast.value);
        coinTossing = false;
        stage.classList.remove('is-tossing');
        setMethodStatus(`第 ${throwIndex} 掷 · ${cast.faces.map((front) => front ? '字' : '背').join('、')} → ${YAO_LABEL[cast.value]}（${cast.value}）`);
        renderCoins();
      };
      if (reducedMotion()) finish();
      else coinTimer = setTimeout(finish, 720);
      renderCoins();
    });
    $('yj-coins-reset').addEventListener('click', () => {
      if (coinTimer) clearTimeout(coinTimer);
      coinTimer = null;
      coinTossing = false;
      coinValues = [];
      result.hidden = true;
      setMethodStatus('铜钱法 · 已重置，请从初爻开始。');
      renderCoins();
    });

    /* ---- yarrow ---- */
    $('yj-yarrow-cast').addEventListener('click', () => {
      const { values, lines } = castYarrow(cryptoRandomSource);
      $('yj-yarrow-log').innerHTML = lines.map((line, i) =>
        `<li>第 ${i + 1} 爻：三变各归奇 ${line.changes.map((c) => c.removed).join('、')}，余 ${line.changes[2].remaining} 策 → ${YAO_LABEL[line.value]}（${line.value}）</li>`
      ).join('');
      setMethodStatus('蓍草演卦完成 · 六爻已按三变过程列出。');
      renderResult(values);
    });
    $('yj-yarrow-reset').addEventListener('click', () => {
      $('yj-yarrow-log').innerHTML = '';
      result.hidden = true;
      setMethodStatus('蓍草法 · 已重置。');
    });

    /* ---- numbers ---- */
    $('yj-numbers-cast').addEventListener('click', () => {
      const raw = [1, 2, 3].map((index) => ($(`yj-num-${index}`) as HTMLInputElement).value.trim());
      const [a, b, c] = raw.map(Number);
      if (raw.some((value) => value === '') || ![a, b, c].every((n) => Number.isFinite(n))) {
        setMethodStatus('请先填写三个整数，再以数字起卦。', true);
        return;
      }
      const cast = castNumbers(a, b, c);
      $('yj-numbers-formula').textContent = cast.formula;
      renderResult(cast.values);
    });

    /* ---- time ---- */
    $('yj-time-cast').addEventListener('click', () => {
      const raw = ['y', 'm', 'd', 'h'].map((key) => ($(`yj-time-${key}`) as HTMLInputElement).value.trim());
      const [y, m, d, h] = raw.map(Number);
      if (raw.some((value) => value === '') || ![y, m, d, h].every((n) => Number.isFinite(n))) {
        setMethodStatus('请填写完整的年、月、日、时，或点击“填入此刻”。', true);
        return;
      }
      try {
        const cast = castTime(y, m, d, h);
        $('yj-time-formula').textContent = cast.formula;
        renderResult(cast.values);
      } catch (error) {
        setMethodStatus(error instanceof Error ? error.message : '时间无法解析。', true);
      }
    });
    $('yj-time-now').addEventListener('click', () => {
      const now = new Date();
      ($('yj-time-y') as HTMLInputElement).value = String(now.getFullYear());
      ($('yj-time-m') as HTMLInputElement).value = String(now.getMonth() + 1);
      ($('yj-time-d') as HTMLInputElement).value = String(now.getDate());
      ($('yj-time-h') as HTMLInputElement).value = String(now.getHours());
      setMethodStatus(`已填入本机此刻 · ${now.getFullYear()}-${now.getMonth() + 1}-${now.getDate()} ${now.getHours()}时`);
    });

    /* ---- manual ---- */
    $('yj-manual-cast').addEventListener('click', () => {
      const errorEl = $('yj-manual-error');
      const raw = [1, 2, 3, 4, 5, 6].map((i) => ($(`yj-man-${i}`) as HTMLInputElement).value);
      try {
        renderResult(castManual(raw));
        errorEl.hidden = true;
        errorEl.textContent = '';
      } catch (error) {
        errorEl.textContent = error instanceof Error ? error.message : '录入有误';
        errorEl.hidden = false;
        result.hidden = true;
        setMethodStatus(errorEl.textContent, true);
      }
    });

    /* ---- 卦录复制：粘贴到笔记房 ---- */
    $('yj-note-copy').addEventListener('click', async () => {
      const state = $('yj-note-state');
      const summary = [
        $('yj-primary').textContent ?? '',
        $('yj-moving').textContent ?? '',
        `之卦：${$('yj-changed').textContent ?? '—'}`,
        `互卦：${$('yj-mutual').textContent ?? '—'}`,
        `错卦：${$('yj-opposite').textContent ?? '—'}`,
        `综卦：${$('yj-reversed').textContent ?? '—'}`,
        '—— 静心堂 · 周易研习，卦象只列名相，不作吉凶断言',
      ].join('\n');
      try {
        await navigator.clipboard.writeText(summary);
        state.innerHTML = '已复制。<a class="jing-note-link" href="/jing/notes/">去笔记房粘贴 →</a>';
      } catch {
        state.textContent = '复制失败，请手动选择文本复制。';
      }
    });

    renderCoins();
  }
</script>

<style>
  .jing-yijing { display: flex; flex-direction: column; gap: 1.25rem; }

  .jing-yj-topbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .jing-yj-note-actions { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.7rem; flex-wrap: wrap; }
  .jing-yj-note-state { font-family: var(--jing-font-ui); font-size: 0.75rem; color: var(--jing-text-dim); }
  .jing-yj-tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .jing-yj-tabs [role="tab"] {
    border: 1px solid var(--jing-border); background: var(--jing-bg-raised);
    color: var(--jing-text-dim); border-radius: 999px;
    padding: 0.35rem 1rem; cursor: pointer; font-size: 0.9rem; letter-spacing: 0.2em;
    font-family: inherit;
  }
  .jing-yj-tabs [role="tab"][aria-selected="true"] {
    border-color: var(--jing-accent); color: var(--jing-accent);
  }
  .jing-yj-method-status {
    min-height: 1.6em; margin: -0.45rem 0 0;
    color: var(--jing-accent); font-family: var(--jing-font-ui); font-size: 0.76rem;
  }
  .jing-yj-method-status.is-error { color: var(--jing-vermilion); }

  .jing-yijing section[role="tabpanel"] {
