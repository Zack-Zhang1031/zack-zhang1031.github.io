---
/**
 * SoundControl — opt-in sound toggle + volume for a room.
 *
 * It never creates Audio objects by itself. Room controllers listen for the
 * `jing:sound` CustomEvent on this root element and only then create or
 * start audio. Volume and enabled state persist via jing settings.
 * Rooms may pass `layers` (extra atmosphere ids) to offer an optional
 * second ambience layer; the chosen layer id rides on the same event.
 */
import { LAYER_LABEL } from '../../lib/jing/sound-fx';

interface Props {
  layers?: string[];
}

const { layers = [] } = Astro.props;
---

<div class="jing-sound" data-sound-control>
  <button
    type="button"
    class="jing-icon-btn jing-sound-toggle"
    aria-pressed="false"
    aria-label="开启环境音"
    title="开启环境音"
  >
    <span aria-hidden="true">静音</span>
  </button>
  <label class="jing-sound-volume-wrap" hidden>
    音量
    <input type="range" class="jing-sound-volume" min="0" max="100" value="60" aria-label="音量" />
  </label>
  {layers.length > 0 && (
    <label class="jing-sound-layer-wrap" hidden>
      氛围
      <select class="jing-sound-layer" aria-label="氛围音">
        <option value="">无</option>
        {layers.map((id) => <option value={id}>{LAYER_LABEL[id] ?? id}</option>)}
      </select>
    </label>
  )}
</div>

<script>
  import { loadSettings, saveSettings } from '../../lib/jing/settings';

  document.querySelectorAll<HTMLElement>('[data-sound-control]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('.jing-sound-toggle');
    const toggleLabel = toggle?.querySelector('span');
    const volumeWrap = root.querySelector<HTMLElement>('.jing-sound-volume-wrap');
    const volume = root.querySelector<HTMLInputElement>('.jing-sound-volume');
    const layerWrap = root.querySelector<HTMLElement>('.jing-sound-layer-wrap');
    const layer = root.querySelector<HTMLSelectElement>('.jing-sound-layer');
    if (!toggle || !volume || !volumeWrap || !toggleLabel) return;

    const loaded = loadSettings(localStorage);
    volume.value = String(Math.round(loaded.settings.volume * 100));
    let enabled = false;

    const emit = () => {
      root.dispatchEvent(new CustomEvent('jing:sound', {
        detail: { enabled, volume: Number(volume.value) / 100, layer: layer?.value || null },
        bubbles: false,
      }));
    };

    toggle.addEventListener('click', () => {
      enabled = !enabled;
      toggle.setAttribute('aria-pressed', String(enabled));
      toggle.setAttribute('aria-label', enabled ? '关闭环境音' : '开启环境音');
      toggleLabel.textContent = enabled ? '有声' : '静音';
      volumeWrap.hidden = !enabled;
      if (layerWrap) layerWrap.hidden = !enabled;
      emit();
    });

    layer?.addEventListener('change', () => {
      if (enabled) emit();
    });

    volume.addEventListener('input', () => {
      const current = loadSettings(localStorage);
      saveSettings(localStorage, {
        ...current.settings,
        volume: Number(volume.value) / 100,
      });
      if (enabled) emit();
    });
  });
</script>

<style>
  .jing-sound {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--jing-font-ui);
    font-size: 0.78rem;
    color: var(--jing-text-dim);
  }
  .jing-sound-toggle span { font-size: 0.72rem; letter-spacing: 0.1em; }
  .jing-sound-volume-wrap { display: flex; align-items: center; gap: 0.4rem; }
  .jing-sound-volume { accent-color: var(--jing-accent); }
  .jing-sound-layer-wrap { display: flex; align-items: center; gap: 0.4rem; }
  .jing-sound-layer {
    font-family: inherit; font-size: 0.75rem; color: var(--jing-text-dim);
    background: var(--jing-bg-raised); border: 1px solid var(--jing-border);
    border-radius: 6px; padding: 0.15rem 0.3rem;
  }
</style>
