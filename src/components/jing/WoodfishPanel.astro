---
/**
 * WoodfishPanel — quiet counting woodfish.
 *
 * Count, local practice totals, average rhythm, and elapsed time. Merit is
 * a private practice label only: there are no rankings, streaks, or rewards.
 * Sound (woodfish strike + optional
 * water ambience) is created only after the user enables sound through
 * the SoundControl toggle. Keyboard (Space/Enter on the fish) and touch
 * are supported through the native button.
 */
import SoundControl from './SoundControl.astro';
---

<div class="jing-muyu" id="jing-muyu-app">
  <div class="jing-muyu-scene">
    <aside class="jing-muyu-stats jing-scene-panel" role="status" aria-live="polite" aria-label="木鱼功德与本次记录">
      <p class="jing-muyu-merit-flash" id="muyu-merit-flash">功德 +1</p>
      <div class="jing-muyu-stat"><span class="jing-muyu-label">今日功德</span><span class="jing-muyu-num" id="muyu-today-merit">0</span></div>
      <div class="jing-muyu-stat"><span class="jing-muyu-label">累计功德</span><span class="jing-muyu-num" id="muyu-total-merit">0</span></div>
      <div class="jing-muyu-stat"><span class="jing-muyu-label">敲击次数</span><span class="jing-muyu-num" id="muyu-count">0</span></div>
      <div class="jing-muyu-stat"><span class="jing-muyu-label">敲击时长</span><span class="jing-muyu-num" id="muyu-elapsed">00:00</span></div>
      <div class="jing-muyu-stat"><span class="jing-muyu-label">平均速度</span><span><span class="jing-muyu-num" id="muyu-rhythm">—</span><small> 次/分</small></span></div>
    </aside>

    <div class="jing-muyu-stage">
      <img class="jing-muyu-prop jing-muyu-prop--incense" src="/jing/generated/muyu/incense-burner.png" alt="" aria-hidden="true" />
      <span class="jing-muyu-prop jing-muyu-prop--candle jing-muyu-prop--candle-left" aria-hidden="true">
        <img src="/jing/generated/muyu/candle.png" alt="" />
      </span>
      <span class="jing-muyu-prop jing-muyu-prop--candle jing-muyu-prop--candle-right" aria-hidden="true">
        <img src="/jing/generated/muyu/candle.png" alt="" />
      </span>
      <img class="jing-muyu-prop jing-muyu-prop--beads" src="/jing/generated/muyu/prayer-beads.png" alt="" aria-hidden="true" />
      <button type="button" id="muyu-fish" class="jing-muyu-fish" aria-label="敲一下木鱼">
        <span class="jing-muyu-strike-sprite" data-strike-frame="0" aria-hidden="true"></span>
        <span class="jing-muyu-hit-label"><b aria-hidden="true">●</b> 敲一下</span>
      </button>
    </div>

    <aside class="jing-muyu-controls jing-scene-panel" aria-label="木鱼控制">
      <h2>静心设置</h2>
      <SoundControl layers={['rain', 'insects', 'tea']} />
      <button type="button" id="muyu-pause" class="jing-btn" aria-pressed="false">暂停敲击</button>
      <button type="button" id="muyu-auto" class="jing-btn" aria-pressed="false">自动敲击</button>
      <label class="jing-muyu-tempo">自动节奏
        <input id="muyu-tempo" type="range" min="30" max="90" step="3" value="36" aria-label="自动敲击速度" />
        <output id="muyu-tempo-value" for="muyu-tempo">36 次/分</output>
      </label>
      <p id="muyu-mode-status" class="jing-muyu-mode-status" role="status" aria-live="polite">手动敲击</p>
      <button type="button" id="muyu-reset" class="jing-btn">清零本次</button>
      <div class="jing-muyu-sit">
        <label class="jing-muyu-sit-label">安坐时长
          <input id="muyu-sit-min" type="number" min="1" max="120" step="1" value="10" aria-label="安坐分钟数" />
          分钟
        </label>
        <button type="button" id="muyu-sit-start" class="jing-btn">开始安坐</button>
        <span id="muyu-sit-status" class="jing-muyu-sit-status" role="status"></span>
      </div>
    </aside>

    <div class="jing-muyu-history jing-scene-panel" aria-label="最近十次敲击节奏">
      <p>敲击记录 <small>最近 10 次</small></p>
      <div id="muyu-history-bars" class="jing-muyu-history-bars" aria-hidden="true">
        {Array.from({ length: 10 }, (_, index) => <i style={`--bar: ${18 + index * 2}%`}></i>)}
      </div>
    </div>
  </div>
  <p class="jing-muyu-hint">轻触木鱼或按空格键敲击。功德仅为本机静修计数，不作排行、奖励或任何现实判断。</p>
</div>

<script>
  import { AMBIENCE_SRC, WOODFISH_SOUND_SRC } from '../../data/jing/figures';
  import { LAYER_SRC, playFx, registerAmbience, setAmbienceVolume } from '../../lib/jing/sound-fx';

  const app = document.getElementById('jing-muyu-app');
  if (app) {
    const countEl = document.getElementById('muyu-count')!;
    const rhythmEl = document.getElementById('muyu-rhythm')!;
    const elapsedEl = document.getElementById('muyu-elapsed')!;
    const fish = document.getElementById('muyu-fish') as HTMLButtonElement;
    const pauseBtn = document.getElementById('muyu-pause') as HTMLButtonElement;
    const resetBtn = document.getElementById('muyu-reset') as HTMLButtonElement;
    const autoBtn = document.getElementById('muyu-auto') as HTMLButtonElement;
    const todayMeritEl = document.getElementById('muyu-today-merit')!;
    const totalMeritEl = document.getElementById('muyu-total-merit')!;
    const meritFlash = document.getElementById('muyu-merit-flash')!;
    const historyBars = Array.from(document.querySelectorAll<HTMLElement>('#muyu-history-bars i'));
    const strikeSprite = fish.querySelector<HTMLElement>('.jing-muyu-strike-sprite');
    const tempo = document.getElementById('muyu-tempo') as HTMLInputElement;
    const tempoValue = document.getElementById('muyu-tempo-value') as HTMLOutputElement;
    const modeStatus = document.getElementById('muyu-mode-status')!;

    let count = 0;
    let intervals: number[] = [];
    let lastStrike = 0;
    let elapsedSec = 0;
    let paused = false;
    let timer: ReturnType<typeof setInterval> | null = null;
    let autoTimer: ReturnType<typeof setInterval> | null = null;
    let strikeTimes: number[] = [];
    let strikeFrameTimers: ReturnType<typeof setTimeout>[] = [];

    const playStrikeFrames = () => {
      strikeFrameTimers.forEach(clearTimeout);
      strikeFrameTimers = [];
      if (!strikeSprite) return;
      const setFrame = (frame: number) => { strikeSprite.dataset.strikeFrame = String(frame); };
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        setFrame(3);
        strikeFrameTimers.push(setTimeout(() => setFrame(0), 140));
        return;
      }
      [1, 2, 3, 4, 5, 0].forEach((frame, index) => {
        strikeFrameTimers.push(setTimeout(() => setFrame(frame), [0, 55, 112, 180, 255, 360][index]));
      });
    };

    const todayKey = () => new Date().toISOString().slice(0, 10);
    type Practice = { date?: string; todayMerit?: number; totalMerit?: number; meditationSeconds?: number };
    const loadPractice = (): Practice => {
      try {
        const raw = localStorage.getItem('jing.practice.v1');
        const value = raw ? JSON.parse(raw) as Practice : {};
        if (value.date !== todayKey()) {
          value.date = todayKey();
          value.todayMerit = 0;
        }
        return value;
      } catch { return { date: todayKey(), todayMerit: 0, totalMerit: 0 }; }
    };
    let practice = loadPractice();
    const savePractice = () => {
      try { localStorage.setItem('jing.practice.v1', JSON.stringify(practice)); } catch {}
    };

    /* audio is created only after explicit opt-in via SoundControl */
    let waterAudio: HTMLAudioElement | null = null;
    let layerAudio: HTMLAudioElement | null = null;
    let layerId: string | null = null;
    let soundOn = false;
    let soundVol = 0.6;

    const soundControl = app.querySelector('[data-sound-control]');
    soundControl?.addEventListener('jing:sound', (e) => {
      const { enabled, volume, layer } = (e as CustomEvent).detail as
        { enabled: boolean; volume: number; layer: string | null };
      soundOn = enabled;
      soundVol = volume;
      if (enabled && !waterAudio) {
        waterAudio = new Audio(AMBIENCE_SRC.water);
        waterAudio.loop = true;
        registerAmbience(waterAudio);
      }
      if (waterAudio) {
        setAmbienceVolume(waterAudio, volume * 0.5);
        if (enabled) void waterAudio.play().catch(() => {});
        else waterAudio.pause();
      }
      /* 可选第二氛围层：雨 / 虫 / 茶 */
      if (!enabled || !layer) {
        layerAudio?.pause();
      } else {
        if (!layerAudio || layerId !== layer) {
          layerAudio?.pause();
          layerAudio = new Audio(LAYER_SRC[layer]);
          layerAudio.loop = true;
          layerId = layer;
          registerAmbience(layerAudio);
        }
        setAmbienceVolume(layerAudio, volume * 0.35);
        void layerAudio.play().catch(() => {});
      }
    });

    const fmt = (sec: number) =>
      `${String(Math.floor(sec / 60)).padStart(2, '0')}:${String(sec % 60).padStart(2, '0')}`;

    const render = () => {
      countEl.textContent = String(count);
      elapsedEl.textContent = fmt(elapsedSec);
      todayMeritEl.textContent = String(Number(practice.todayMerit || 0));
      totalMeritEl.textContent = String(Number(practice.totalMerit || 0));
      if (intervals.length >= 2) {
        const recent = intervals.slice(-8);
        const avgMs = recent.reduce((a, b) => a + b, 0) / recent.length;
        rhythmEl.textContent = avgMs > 0 ? String(Math.round(60000 / avgMs)) : '—';
        /* 节奏方差足够低时，鱼身笼一层平稳微光（纯粹视觉反馈，无功德语义） */
        const variance = recent.reduce((a, b) => a + (b - avgMs) ** 2, 0) / recent.length;
        const cv = avgMs > 0 ? Math.sqrt(variance) / avgMs : Infinity;
        fish.classList.toggle('is-steady', recent.length >= 6 && cv < 0.12);
      } else {
        rhythmEl.textContent = '—';
        fish.classList.remove('is-steady');
      }
      const recentTimes = strikeTimes.slice(-10);
      historyBars.forEach((bar, index) => {
        const time = recentTimes[index];
        const previous = index > 0 ? recentTimes[index - 1] : undefined;
        const delta = time && previous ? Math.max(180, time - previous) : 1800;
        const height = time ? Math.max(22, Math.min(92, 100 - delta / 22)) : 12;
        bar.style.setProperty('--bar', `${height}%`);
        bar.classList.toggle('is-active', Boolean(time));
      });
    };

    const startTimer = () => {
      if (timer) return;
      timer = setInterval(() => {
        if (!paused) {
          elapsedSec += 1;
          render();
        }
      }, 1000);
    };

    fish.addEventListener('click', (e) => {
      if (paused) return;
      const now = performance.now();
      if (lastStrike > 0) intervals.push(now - lastStrike);
      lastStrike = now;
      count += 1;
      strikeTimes.push(Date.now());
      practice = loadPractice();
      practice.todayMerit = Number(practice.todayMerit || 0) + 1;
      practice.totalMerit = Number(practice.totalMerit || 0) + 1;
      savePractice();
      startTimer();
      render();

      meritFlash.classList.remove('is-visible');
      void meritFlash.offsetWidth;
      meritFlash.classList.add('is-visible');

      if (soundOn) playFx(WOODFISH_SOUND_SRC, soundVol, 0, 0.98 + Math.random() * 0.04);
      app.classList.add('is-practicing');
      /* 鱼身向敲击侧微倾（键盘敲击居中不倾） */
      const fishRect = fish.getBoundingClientRect();
      const rel = e.clientX
        ? (e.clientX - (fishRect.left + fishRect.width / 2)) / (fishRect.width / 2)
        : 0;
      fish.style.setProperty('--hit-tilt', `${(rel * 1.2).toFixed(2)}deg`);
      fish.classList.remove('is-hit');
      void fish.offsetWidth;
      fish.classList.add('is-hit');
      playStrikeFrames();
      modeStatus.textContent = autoTimer
        ? `自动敲击 · ${tempo.value} 次/分`
        : `手动敲击 · 第 ${count} 声`;

      /* 涟漪自敲击点荡开 */
      const stage = fish.parentElement!;
      const stageRect = stage.getBoundingClientRect();
      const ripple = document.createElement('span');
      ripple.className = 'jing-muyu-ripple';
      ripple.setAttribute('aria-hidden', 'true');
      ripple.style.left = `${e.clientX ? e.clientX - stageRect.left : stageRect.width / 2}px`;
      ripple.style.top = `${e.clientY ? e.clientY - stageRect.top : stageRect.height / 2}px`;
      ripple.style.width = '32%';
      ripple.style.height = '34%';
      stage.appendChild(ripple);
      setTimeout(() => ripple.remove(), 820);
    });

    pauseBtn.addEventListener('click', () => {
      paused = !paused;
      pauseBtn.textContent = paused ? '继续敲击' : '暂停敲击';
      pauseBtn.setAttribute('aria-pressed', String(paused));
      fish.setAttribute('aria-disabled', String(paused));
      modeStatus.textContent = paused
        ? '已暂停 · 计时与敲击均停下'
        : (autoTimer ? `自动敲击 · ${tempo.value} 次/分` : '手动敲击');
      if (waterAudio) {
        if (paused) waterAudio.pause();
        else if (soundControl?.querySelector('.jing-sound-toggle')?.getAttribute('aria-pressed') === 'true') {
          void waterAudio.play().catch(() => {});
        }
      }
    });

    resetBtn.addEventListener('click', () => {
      if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
      autoBtn.textContent = '自动敲击';
      autoBtn.setAttribute('aria-pressed', 'false');
      count = 0;
      intervals = [];
      lastStrike = 0;
      elapsedSec = 0;
      strikeTimes = [];
      paused = false;
      pauseBtn.textContent = '暂停敲击';
      pauseBtn.setAttribute('aria-pressed', 'false');
      fish.setAttribute('aria-disabled', 'false');
      if (timer) { clearInterval(timer); timer = null; }
      modeStatus.textContent = '本次已清零 · 可重新开始';
      app.classList.remove('is-practicing');
      render();
    });

    const autoIntervalMs = () => Math.round(60_000 / Number(tempo.value));
    const startAuto = (strikeNow: boolean) => {
      if (autoTimer) clearInterval(autoTimer);
      if (strikeNow) fish.click();
      autoTimer = setInterval(() => fish.click(), autoIntervalMs());
      autoBtn.textContent = '停止自动';
      autoBtn.setAttribute('aria-pressed', 'true');
      modeStatus.textContent = `自动敲击 · ${tempo.value} 次/分`;
    };

    autoBtn.addEventListener('click', () => {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
        autoBtn.textContent = '自动敲击';
        autoBtn.setAttribute('aria-pressed', 'false');
        modeStatus.textContent = '自动敲击已停止 · 可手动继续';
        return;
      }
      if (paused) pauseBtn.click();
      startAuto(true);
    });

    tempo.addEventListener('input', () => {
      tempoValue.value = `${tempo.value} 次/分`;
      if (autoTimer) startAuto(false);
      else modeStatus.textContent = `自动节奏已设为 ${tempo.value} 次/分`;
    });

    /* ---- 安坐计时：纯倒计时，到时一记引磬 ---- */
    const sitMin = document.getElementById('muyu-sit-min') as HTMLInputElement;
    const sitStartBtn = document.getElementById('muyu-sit-start') as HTMLButtonElement;
    const sitStatus = document.getElementById('muyu-sit-status')!;
    let sitRemaining = 0;
    let sitTimer: ReturnType<typeof setInterval> | null = null;

    const stopSit = (completed: boolean) => {
      if (sitTimer) { clearInterval(sitTimer); sitTimer = null; }
      sitStartBtn.textContent = '开始安坐';
      sitMin.disabled = false;
      if (completed) {
        sitStatus.textContent = '安坐已满。';
        if (soundOn) playFx(AMBIENCE_SRC.chime, soundVol * 0.8);
      }
    };

    sitStartBtn.addEventListener('click', () => {
      if (sitTimer) {
        stopSit(false);
        sitStatus.textContent = '已作罢。';
        return;
      }
      const minutes = Math.min(120, Math.max(1, Math.round(Number(sitMin.value) || 10)));
      sitMin.value = String(minutes);
      sitRemaining = minutes * 60;
      sitStartBtn.textContent = '结束安坐';
      sitMin.disabled = true;
      sitStatus.textContent = `余 ${fmt(sitRemaining)}`;
      sitTimer = setInterval(() => {
        sitRemaining -= 1;
        if (sitRemaining <= 0) stopSit(true);
        else sitStatus.textContent = `余 ${fmt(sitRemaining)}`;
      }, 1000);
    });

    render();
  }
</script>

<style>
  .jing-muyu { display: block; width: 100%; }

  .jing-muyu-stats { display: flex; gap: 2.5rem; }
  .jing-muyu-stat { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; }
  .jing-muyu-num { font-size: 1.6rem; font-variant-numeric: tabular-nums; color: var(--jing-accent); }
  .jing-muyu-label { font-family: var(--jing-font-ui); font-size: 0.72rem; color: var(--jing-text-dim); }

  .jing-muyu-fish {
    border: none;
    background: none;
    padding: 0;
    width: min(220px, 60vw);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .jing-muyu-fish:focus-visible { outline: 2px solid var(--jing-accent); outline-offset: 6px; border-radius: 50%; }

  .fish-body { fill: #7a5230; }
  html.dark .fish-body { fill: #8a5f38; }
  .fish-sheen { fill: url(#none); fill: rgba(255, 240, 210, 0.07); }
  .fish-eye { fill: #2d1d0e; }
  .fish-mouth { fill: none; stroke: #2d1d0e; stroke-width: 3; stroke-linecap: round; }
  .fish-belly { fill: none; stroke: rgba(45, 29, 14, 0.55); stroke-width: 2.5; stroke-linecap: round; }

  /* 敲击反馈：压扁而非缩小——木鱼被敲是形变，不是体积变化 */
  .jing-muyu-fish.is-hit .jing-muyu-strike-sprite { animation: muyu-hit 0.16s ease; }
  @keyframes muyu-hit {
    0% { transform: translate(-50%, -50%) scale(1) scaleY(1) rotate(0deg); }
    45% { transform: translate(-50%, -50%) scale(0.99) scaleY(0.93) rotate(var(--hit-tilt, 0deg)); }
    100% { transform: translate(-50%, -50%) scale(1) scaleY(1) rotate(0deg); }
  }
  /* 稳定辉光与敲击反馈同存时叠加（transform 与 filter 互不干扰） */
  .jing-muyu-fish.is-hit.is-steady .jing-muyu-strike-sprite { animation: muyu-hit 0.16s ease, muyu-steady 4.5s ease-in-out infinite; }

  /* 敲击涟漪：动画禁用时保持不可见 */
  .jing-muyu-stage { position: relative; display: flex; justify-content: center; }
  .jing-muyu-ripple {
    position: absolute; left: 50%; top: 50%;
    width: 60%; height: 62%;
    transform: translate(-50%, -50%);
    border: 1.5px solid var(--jing-accent);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    animation: muyu-ripple 0.9s ease-out;
  }
  @keyframes muyu-ripple {
    from { opacity: 0.55; transform: translate(-50%, -50%) scale(0.72); }
    to { opacity: 0; transform: translate(-50%, -50%) scale(1.35); }
  }

  /* 节奏稳定时的呼吸微光（收着点，别让光晕读作体积膨胀） */
  .jing-muyu-fish.is-steady .jing-muyu-strike-sprite { animation: muyu-steady 4.5s ease-in-out infinite; }
  @keyframes muyu-steady {
    0%, 100% { filter: drop-shadow(0 0 3px rgba(184, 147, 74, 0.22)); }
    50% { filter: drop-shadow(0 0 9px rgba(184, 147, 74, 0.38)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .jing-muyu-fish.is-hit .jing-muyu-strike-sprite,
    .jing-muyu-fish.is-hit.is-steady .jing-muyu-strike-sprite,
    .jing-muyu-ripple,
    .jing-muyu-fish.is-steady .jing-muyu-strike-sprite { animation: none; }
    .jing-muyu-ripple { opacity: 0; }
    .jing-muyu-fish.is-steady .jing-muyu-strike-sprite { filter: drop-shadow(0 0 8px rgba(184, 147, 74, 0.35)); }
  }

  .jing-muyu-controls { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; justify-content: center; }

  .jing-muyu-tempo {
    display: grid; grid-template-columns: 1fr auto; gap: 0.3rem 0.55rem; align-items: center;
    font-family: var(--jing-font-ui); font-size: 0.72rem; color: var(--jing-text-dim);
  }
  .jing-muyu-tempo input { grid-column: 1 / -1; width: 100%; accent-color: var(--jing-accent); }
  .jing-muyu-tempo output { color: var(--jing-accent); font-variant-numeric: tabular-nums; }
  .jing-muyu-mode-status {
    min-height: 1.35em; margin: 0; text-align: center;
    font-family: var(--jing-font-ui); font-size: 0.7rem; color: var(--jing-text-dim);
  }

  .jing-muyu-sit { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; justify-content: center; }
  .jing-muyu-sit-label {
    font-family: var(--jing-font-ui); font-size: 0.78rem; color: var(--jing-text-dim);
    display: flex; align-items: center; gap: 0.4rem;
  }
  .jing-muyu-sit-label input {
    width: 3.4rem; text-align: center; font-family: inherit; font-size: 0.85rem;
    background: var(--jing-bg-raised); color: var(--jing-text);
    border: 1px solid var(--jing-border); border-radius: 6px; padding: 0.2rem 0.3rem;
  }
  .jing-muyu-sit-status {
    font-family: var(--jing-font-ui); font-size: 0.78rem; color: var(--jing-accent);
    font-variant-numeric: tabular-nums; min-width: 5em;
  }

  .jing-muyu-hint { font-family: var(--jing-font-ui); font-size: 0.75rem; color: var(--jing-text-dim); margin: 0; max-width: 34em; text-align: center; }
</style>
