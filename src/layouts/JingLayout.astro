---
import '../styles/jing.css';

interface Props {
  title: string;
  description?: string;
  isHall?: boolean;
}

const {
  title,
  description = '静心堂 — 本地运行的传统文化研习空间',
  isHall = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const routeKey = currentPath === '/jing/'
  ? 'hall'
  : currentPath.split('/').filter(Boolean).at(-1) || 'hall';

const groups = [
  {
    label: '静心', mark: '息', items: [
      { href: '/jing/meditation/', name: '静心', icon: '○' },
      { href: '/jing/muyu/', name: '木鱼', icon: '◉' },
    ],
  },
  {
    label: '礼敬', mark: '礼', items: [
      { href: '/jing/fo/', name: '礼佛', icon: '合' },
      { href: '/jing/dao/', name: '敬道', icon: '拱' },
      { href: '/jing/chouqian/', name: '抽签', icon: '签' },
    ],
  },
  {
    label: '研习', mark: '研', items: [
      { href: '/jing/yixue/', name: '五行', icon: '五' },
      { href: '/jing/bazi/', name: '八字', icon: '八' },
      { href: '/jing/yijing/', name: '周易', icon: '易' },
      { href: '/jing/qimen/', name: '奇门', icon: '门' },
    ],
  },
  {
    label: '私藏', mark: '藏', items: [
      { href: '/jing/notes/', name: '静心手札', icon: '札' },
    ],
  },
];
---

<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/jing/favicon.svg" />
  {isHall && <link rel="preload" as="image" href="/jing/scene/hall-courtyard.webp" />}
  <title>{title} · 静心堂</title>
  <script is:inline>
    const t = localStorage.getItem('theme') || 'dark';
    document.documentElement.classList.toggle('light', t === 'light');
    document.documentElement.classList.toggle('dark', t !== 'light');
  </script>
</head>
<body class:list={['jing-body', `jing-route-${routeKey}`, isHall && 'jing-is-hall']}>
  <div class="jing-shell jing-app-shell">
    <aside class="jing-sidebar" id="jing-sidebar" aria-label="静心堂主导航">
      <a class="jing-brand" href="/jing/" aria-current={isHall ? 'page' : undefined}>
        <span>静心堂</span><i aria-hidden="true">静</i>
      </a>
      <nav class="jing-primary-nav">
        {groups.map((group) => (
          <section class="jing-nav-group">
            <h2><span aria-hidden="true">{group.mark}</span>{group.label}</h2>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                    <b aria-hidden="true">{item.icon}</b><span>{item.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </nav>
      <p class="jing-sidebar-motto">心静则明 · 福自归来</p>
    </aside>

    <div class="jing-content-shell">
      <header class="jing-topbar">
        <button id="jing-nav-toggle" class="jing-icon-btn jing-nav-toggle" type="button" aria-label="打开静心堂导航" aria-expanded="false" aria-controls="jing-sidebar">
          <span aria-hidden="true">☰</span>
        </button>
        {isHall ? (
          <span class="jing-crumb" aria-current="page">静心堂</span>
        ) : (
          <a class="jing-crumb" href="/jing/">‹ 返回静心堂</a>
        )}
        <div class="jing-top-actions">
          <span class="jing-local-badge" title="所有数据只保留在本机">本地静修</span>
          <button id="jing-theme-toggle" class="jing-icon-btn" type="button" aria-label="切换明暗主题" title="切换明暗主题">
            <span aria-hidden="true">☾</span>
          </button>
        </div>
      </header>

      <main class="jing-main">
        <slot />
      </main>

      <footer class="jing-foot">
        <a href="/" class="jing-home">返回主页</a>
        <p class="jing-note">所有计算与笔记仅在本机浏览器内运行，不会上传任何信息。</p>
      </footer>
    </div>
  </div>

  <button id="jing-nav-scrim" class="jing-nav-scrim" type="button" aria-label="关闭静心堂导航"></button>
  <button id="jing-back-to-top" class="jing-back-to-top" type="button" aria-label="返回页面顶端" title="返回顶部">
    <span aria-hidden="true">↑</span>
  </button>

  <script is:inline>
    (function () {
      var btn = document.getElementById('jing-theme-toggle');
      function syncIcon() {
        var light = document.documentElement.classList.contains('light');
        if (btn) btn.querySelector('span').textContent = light ? '☀' : '☾';
      }
      syncIcon();
      btn && btn.addEventListener('click', function () {
        var light = document.documentElement.classList.toggle('light');
        document.documentElement.classList.toggle('dark', !light);
        localStorage.setItem('theme', light ? 'light' : 'dark');
        syncIcon();
      });

      var navToggle = document.getElementById('jing-nav-toggle');
      var sidebar = document.getElementById('jing-sidebar');
      var scrim = document.getElementById('jing-nav-scrim');
      function setNav(open) {
        document.body.classList.toggle('jing-nav-open', open);
        navToggle && navToggle.setAttribute('aria-expanded', String(open));
      }
      navToggle && navToggle.addEventListener('click', function () {
        setNav(!document.body.classList.contains('jing-nav-open'));
      });
      scrim && scrim.addEventListener('click', function () { setNav(false); });
      sidebar && sidebar.addEventListener('click', function (event) {
        if (event.target.closest('a')) setNav(false);
      });

      var top = document.getElementById('jing-back-to-top');
      function updateTop() {
        top && top.classList.toggle('is-visible', window.scrollY > 480);
      }
      window.addEventListener('scroll', updateTop, { passive: true });
      top && top.addEventListener('click', function () {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
      });
      updateTop();

      var zenTimer = null;
      function wake() {
        document.body.classList.remove('is-zen');
        if (zenTimer) clearTimeout(zenTimer);
        zenTimer = setTimeout(function () { document.body.classList.add('is-zen'); }, 4 * 60 * 1000);
      }
      ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (ev) {
        window.addEventListener(ev, wake, { passive: true });
      });
      wake();

      document.addEventListener('click', function (e) {
        var link = e.target && e.target.closest ? e.target.closest('a[href^="/jing/"]') : null;
        if (!link || sessionStorage.getItem('jing.sound-on') === '0') return;
        try {
          var vol = 0.5;
          var raw = localStorage.getItem('jing.settings.v1');
          if (raw) vol = JSON.parse(raw).volume || 0.5;
          var audio = new Audio('/jing/audio/paper-unfurl.mp3');
          audio.volume = Math.min(0.5, vol * 0.5);
          audio.play().catch(function () {});
        } catch (err) {}
      }, true);
    })();
  </script>
</body>
</html>
