---
import '../styles/global.css';
import AccountModal from '../components/AccountModal.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '张坤 — 独立游戏开发者 / AI 与算法爱好者' } = Astro.props;
const siteUrl = Astro.site?.href || 'https://zz1031.vercel.app';
const canonical = new URL(Astro.url.pathname, siteUrl).href;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/posts/', label: 'Blog' },
  { href: '/games/', label: 'Games' },
  { href: '/about/', label: 'About' },
];
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="canonical" href={canonical} />
  <meta name="author" content="Zack-Zhang1031" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${siteUrl}/images/48.png`} />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" type="image/png" href="/favicon-zhang.png" />
  <title>{title}</title>
  <script is:inline>
    const t = localStorage.getItem('theme') || 'dark';
    document.documentElement.classList.toggle('light', t === 'light');
    document.documentElement.classList.toggle('dark', t !== 'light');
  </script>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-logo">
        <img src="/images/48.png" alt="张坤" width="24" height="24" />
        <span>张坤</span>
      </a>
      <button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="打开导航菜单">
        <span></span><span></span>
      </button>
      <nav id="primary-navigation" class="nav-links" aria-label="主导航">
        {navItems.map((item) => (
          <a href={item.href} class={`nav-link${currentPath === item.href ? ' active' : ''}`}>{item.label}</a>
        ))}
        <button id="wechat-qr-btn" class="nav-link" data-qr-trigger title="扫码关注公众号">公众号</button>
        <button id="theme-toggle" class="theme-toggle" title="切换主题">🌙</button>
      </nav>
    </div>
  </header>

  <canvas id="bg-canvas" class="bg-canvas" aria-hidden="true"></canvas>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-left">
        <p>© 2024–2026 张坤</p>
        <p>Built with <a href="https://astro.build" target="_blank" rel="noopener">astro</a> · Published via <a href="https://workers.cloudflare.com" target="_blank" rel="noopener">cloudflare workers</a></p>
        <p class="comment-account">💬 评论账号：<a href="https://lz1031-waline.vercel.app/ui/login" data-account-open="login">登录</a> · <a href="https://lz1031-waline.vercel.app/ui/register" data-account-open="register">注册</a><span>（可选，仍可匿名评论）</span></p>
      </div>
      <div class="footer-right">
        <span>pv <span id="busuanzi_value_site_pv">—</span> · uv <span id="busuanzi_value_site_uv">—</span></span>
      </div>
    </div>
  </footer>

  <AccountModal />

  <button id="back-to-top" class="back-to-top" type="button" aria-label="返回网页顶端" title="返回顶部">
    <span aria-hidden="true">↑</span>
  </button>

  <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js" is:inline></script>
  <script is:inline>
    const navToggle = document.getElementById('nav-toggle');
    const primaryNav = document.getElementById('primary-navigation');
    function closeNavigation() {
      navToggle?.setAttribute('aria-expanded', 'false');
      navToggle?.setAttribute('aria-label', '打开导航菜单');
      primaryNav?.classList.remove('is-open');
    }
    navToggle?.addEventListener('click', () => {
      const open = navToggle.getAttribute('aria-expanded') !== 'true';
      navToggle.setAttribute('aria-expanded', String(open));
      navToggle.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
      primaryNav?.classList.toggle('is-open', open);
    });
    primaryNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNavigation));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeNavigation(); });
  </script>
  <script is:inline>
    const btn = document.getElementById('theme-toggle');
    function syncIcon() {
      const light = document.documentElement.classList.contains('light');
      if (btn) btn.textContent = light ? '☀️' : '🌙';
    }
    syncIcon();
    btn?.addEventListener('click', () => {
      const light = document.documentElement.classList.toggle('light');
      document.documentElement.classList.toggle('dark', !light);
      localStorage.setItem('theme', light ? 'light' : 'dark');
      syncIcon();
      window.dispatchEvent(new CustomEvent('themechange'));
    });
  </script>
  <script is:inline>
    // Scroll reveal
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.08 });
    document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
  </script>

  <script is:inline>
    // Micro-interactions: progress bar / ripple / spotlight / stagger / page fade
    (function () {
      // 1. Scroll progress bar
      var bar = document.createElement('div');
      bar.className = 'scroll-progress';
      document.body.appendChild(bar);
      var ticking = false;
      var backToTop = document.getElementById('back-to-top');
      function updateScrollUi() {
        var h = document.documentElement;
        var max = h.scrollHeight - h.clientHeight;
        bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
        backToTop?.classList.toggle('is-visible', h.scrollTop > 480);
      }
      window.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          updateScrollUi();
          ticking = false;
        });
      }, { passive: true });
      backToTop?.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      updateScrollUi();

      // 2. Ripple on button click
      var RIPPLE_SEL = '.nav-link, .theme-toggle, .hero-link, .hero-link-primary, .btn-play, .filter-chip, .gs-ctrl-btn, .anchor-nav a, .post-nav-link';
      document.addEventListener('click', function (e) {
        var btn = e.target.closest(RIPPLE_SEL);
        if (!btn) return;
        var rect = btn.getBoundingClientRect();
        var size = Math.max(rect.width, rect.height) * 1.2;
        var r = document.createElement('span');
        r.className = 'ripple';
        r.style.width = r.style.height = size + 'px';
        r.style.left = (e.clientX - rect.left - size / 2) + 'px';
        r.style.top = (e.clientY - rect.top - size / 2) + 'px';
        btn.appendChild(r);
        setTimeout(function () { r.remove(); }, 650);
      });

      // 3. Card spotlight — border glow follows cursor
      document.addEventListener('mousemove', function (e) {
        var card = e.target.closest('.project-card, .post-card, .game-showcase');
        if (!card) return;
        var rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', (e.clientX - rect.left) + 'px');
        card.style.setProperty('--my', (e.clientY - rect.top) + 'px');
      }, { passive: true });

      // 4. Staggered entrance for page content
      var els = document.querySelectorAll(
        'main .page-header, main .anchor-nav, main .filter-bar, main .game-showcase, ' +
        'main .project-grid > .project-card, main .post-list > .post-card, ' +
        'main .post-detail-header, main .prose, main .post-nav, main .comments-section'
      );
      els.forEach(function (el, i) {
        var delay = 100 + Math.min(i, 10) * 70;
        el.classList.add('stagger-in');
        setTimeout(function () { el.classList.add('play'); }, delay);
        setTimeout(function () { el.classList.remove('stagger-in', 'play'); }, delay + 650);
      });

      // 5. Fade out before internal navigation
      document.addEventListener('click', function (e) {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        var a = e.target.closest('a');
        if (!a || a.target || a.download) return;
        var href = a.getAttribute('href') || '';
        if (!href || href.charAt(0) === '#' || href.indexOf('mailto:') === 0) return;
        var url;
        try { url = new URL(a.href, location.href); } catch (err) { return; }
        if (url.origin !== location.origin) return;
        if (url.pathname === location.pathname && url.search === location.search && url.hash) return;
        e.preventDefault();
        if (url.href === location.href) return;
        document.body.classList.add('page-exit');
        setTimeout(function () { location.href = url.href; }, 170);
      });
    })();
  </script>

  <script is:inline>
    // Quiet constellation — sparse dots, with links only near a fine pointer.
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var canvas = document.getElementById('bg-canvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var W = 0, H = 0;
      var particles = [];
      var MOUSE_DIST = 190;
      var hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      function spawn() {
        return {
          x: Math.random() * W,
          y: Math.random() * H,
          vx: (Math.random() - 0.5) * 0.32,
          vy: (Math.random() - 0.5) * 0.32,
          r: 0.8 + Math.random() * 1.3,
          tw: Math.random() * Math.PI * 2,
          ts: 0.4 + Math.random() * 1.1
        };
      }

      function resize() {
        var DPR = Math.min(window.devicePixelRatio || 1, 1.5);
        W = window.innerWidth;
        H = window.innerHeight;
        canvas.width = Math.round(W * DPR);
        canvas.height = Math.round(H * DPR);
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
        var target = hasFinePointer
          ? Math.round(Math.min(38, Math.max(18, (W * H) / 50000)))
          : Math.round(Math.min(18, Math.max(10, (W * H) / 80000)));
        while (particles.length < target) particles.push(spawn());
        particles.length = target;
      }
      window.addEventListener('resize', resize);

      var mouse = { x: -9999, y: -9999 };
      document.addEventListener('pointermove', function (e) {
        if (!hasFinePointer) return;
        mouse.x = e.clientX;
        mouse.y = e.clientY;
      }, { passive: true });
      document.addEventListener('mouseleave', function () { mouse.x = -9999; mouse.y = -9999; });

      var running = true;
      document.addEventListener('visibilitychange', function () {
        var was = running;
        running = !document.hidden;
        if (running && !was) requestAnimationFrame(frame);
      });

      var last = 0;
      function frame(t) {
        if (!running) return;
        requestAnimationFrame(frame);
        var dt = Math.min(50, t - last); last = t;
        var k = dt / 16.7;
        var light = document.documentElement.classList.contains('light');
        var dotColor = light ? '60,66,84' : '185,196,220';
        var mouseColor = light ? '200,64,60' : '232,93,78';
        ctx.clearRect(0, 0, W, H);
        ctx.lineWidth = 1;

        var i, p;
        for (i = 0; i < particles.length; i++) {
          p = particles[i];

          var dx = mouse.x - p.x, dy = mouse.y - p.y;
          var d2 = dx * dx + dy * dy;
          if (d2 < MOUSE_DIST * MOUSE_DIST && d2 > 1) {
            var d = Math.sqrt(d2);
            var f = (1 - d / MOUSE_DIST) * 0.010;
            p.vx += (dx / d) * f * k;
            p.vy += (dy / d) * f * k;
          }
          p.vx *= 0.996; p.vy *= 0.996;
          var sp = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
          if (sp > 0.85) { p.vx = p.vx / sp * 0.85; p.vy = p.vy / sp * 0.85; }
          p.x += p.vx * k;
          p.y += p.vy * k;
          if (p.x < -15) p.x = W + 15; else if (p.x > W + 15) p.x = -15;
          if (p.y < -15) p.y = H + 15; else if (p.y > H + 15) p.y = -15;

          p.tw += 0.018 * p.ts * k;
          var a = 0.32 + 0.28 * Math.sin(p.tw);
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(' + dotColor + ',' + a + ')';
          ctx.fill();
        }

        // Accent links appear only around the pointer.
        for (i = 0; hasFinePointer && i < particles.length; i++) {
          p = particles[i];
          var mx = p.x - mouse.x, my = p.y - mouse.y;
          var md2 = mx * mx + my * my;
          if (md2 < MOUSE_DIST * MOUSE_DIST) {
            var md = Math.sqrt(md2);
            var ma = (1 - md / MOUSE_DIST) * (light ? 0.30 : 0.35);
            ctx.strokeStyle = 'rgba(' + mouseColor + ',' + ma + ')';
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(mouse.x, mouse.y);
            ctx.stroke();
          }
        }
      }
      resize();
      requestAnimationFrame(frame);
    })();
  </script>

  <!-- WeChat QR Code Popover -->
  <div id="wechat-qr-overlay" class="qr-overlay" style="display:none;">
    <div class="qr-card" onclick="event.stopPropagation()">
      <button class="qr-close" onclick="document.getElementById('wechat-qr-overlay').style.display='none'" title="关闭">✕</button>
      <img src="/images/wechat-qr.jpg" alt="公众号二维码" class="qr-image" />
      <p class="qr-text">扫码关注公众号</p>
    </div>
  </div>
  <script is:inline>
    const qrBtns = document.querySelectorAll('[data-qr-trigger]');
    const qrOverlay = document.getElementById('wechat-qr-overlay');
    qrBtns.forEach(btn => {
      btn?.addEventListener('click', () => {
        if (qrOverlay) {
          qrOverlay.style.display = qrOverlay.style.display === 'none' ? 'flex' : 'none';
        }
      });
    });
    qrOverlay?.addEventListener('click', () => { qrOverlay.style.display = 'none'; });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && qrOverlay) qrOverlay.style.display = 'none';
    });
  </script>
</body>
</html>
